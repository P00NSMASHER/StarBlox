  </Item>
  <Item class="StarterPlayer" referent="14">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="15">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">LanternIslandClient</string>
        </Properties>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">FeedbackController</string>
            <string name="Source">--!nonstrict
-- Client presentation only. No answers, rewards, profiles or server rules change here.
local Lighting=game:GetService("Lighting")
local RunService=game:GetService("RunService")
local GuiService=game:GetService("GuiService")
local FeedbackController={}
FeedbackController.__index=FeedbackController
function FeedbackController.new(context)
 local self=setmetatable({context=context,connections={},destroyed=false,ambient={},ambientSet={}},FeedbackController)
 table.insert(self.connections,context.resultReceived:Connect(function(result)
  if result.code=="MISSION_COMPLETE" then
   local cam=workspace.CurrentCamera
   if cam then
    local original=cam.FieldOfView;cam.FieldOfView=original-3
    task.delay(.18,function() if not self.destroyed and cam.Parent then cam.FieldOfView=original end end)
   end
  end
 end))
 return self
end
function FeedbackController:_present(instance)
 if instance:IsA("PointLight") and instance.Name=="WarmLight" then
  instance.Brightness=.65;instance.Range=16
 elseif instance:IsA("BillboardGui") then
  -- Distant station signs were covering the pet and the path across the island.
  local pet=instance.Parent and instance.Parent.Name=="Body"
  instance.MaxDistance=pet and 12 or 24
  instance.AlwaysOnTop=false
  if not pet then instance.Size=UDim2.fromOffset(154,42) end
 elseif instance:IsA("ProximityPrompt") and instance.Name=="PetPip" then
  instance.UIOffset=Vector2.new(0,64)
 elseif instance:IsA("BasePart") and instance:GetAttribute("AmbientFloat")==true and not self.ambientSet[instance] then
  self.ambientSet[instance]=true;table.insert(self.ambient,instance)
 end
end
function FeedbackController:_prompts(state)
 local mission=state and state.mission
 if not mission or not self.world then return end
 for _,p in ipairs(self.world:GetDescendants()) do
  if p:IsA("ProximityPrompt") then
   local mid=p:GetAttribute("MissionId")
   if type(mid)=="string" then
    local index=p:GetAttribute("CheckpointIndex")
    p.Enabled=mission.status~="ACTIVE" and (
     (mid==mission.missionId and mission.status~="COMPLETED" and index==mission.checkpointIndex)
     or (mid~=mission.missionId and index==1))
   elseif p.Name=="PetPip" then
    local owner=p.Parent and p.Parent.Parent and p.Parent.Parent:GetAttribute("OwnerUserId")
    p.Enabled=owner==self.context.player.UserId and mission.status~="ACTIVE"
   end
  end
 end
end
function FeedbackController:mount(_playerGui)
 self.previousExposure=Lighting.ExposureCompensation
 Lighting.ExposureCompensation=-.25
 self.bloom=Instance.new("BloomEffect");self.bloom.Name="LanternClientBloom";self.bloom.Intensity=.08;self.bloom.Size=14;self.bloom.Threshold=1.85;self.bloom.Parent=Lighting
 self.color=Instance.new("ColorCorrectionEffect");self.color.Name="LanternClientColor";self.color.Saturation=.06;self.color.Contrast=.025;self.color.Brightness=.01;self.color.Parent=Lighting
 self.sun=Instance.new("SunRaysEffect");self.sun.Name="LanternClientSun";self.sun.Intensity=.03;self.sun.Spread=.7;self.sun.Parent=Lighting
 local reduced=false;pcall(function() reduced=GuiService.ReducedMotionEnabled==true end)
 if not reduced then
  table.insert(self.connections,RunService.RenderStepped:Connect(function()
   local now=os.clock()
   for i=#self.ambient,1,-1 do
    local p=self.ambient[i]
    if not p.Parent then self.ambientSet[p]=nil;table.remove(self.ambient,i)
    else
     local baseY=p:GetAttribute("FloatBaseY");local phase=p:GetAttribute("FloatPhase") or 0
     if type(baseY)=="number" then
      p.Position=Vector3.new(p.Position.X,baseY+math.sin(now*1.25+phase)*.32,p.Position.Z)
      p.Transparency=.08+(.5+.5*math.sin(now*1.7+phase))*.16
     end
    end
   end
  end))
 end
 task.spawn(function()
  local world=workspace:WaitForChild("LanternIslandWorld",10)
  if not world or self.destroyed then return end
  self.world=world
  for _,instance in ipairs(world:GetDescendants()) do self:_present(instance) end
  table.insert(self.connections,world.DescendantAdded:Connect(function(instance)
   self:_present(instance)
   if instance:IsA("ProximityPrompt") then self:_prompts(self.context.getState()) end
  end))
  table.insert(self.connections,self.context.stateChanged:Connect(function(state) self:_prompts(state) end))
  self:_prompts(self.context.getState())
 end)
end
function FeedbackController:destroy()
 self.destroyed=true
 for _,c in ipairs(self.connections) do c:Disconnect() end
 if self.bloom then self.bloom:Destroy() end;if self.color then self.color:Destroy() end;if self.sun then self.sun:Destroy() end
 if self.previousExposure~=nil and Lighting.ExposureCompensation==-.25 then Lighting.ExposureCompensation=self.previousExposure end
end
return FeedbackController</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">InteractionController</string>
            <string name="Source"><![CDATA[--!nonstrict
local ProximityPromptService=game:GetService("ProximityPromptService")
local StarterGui=game:GetService("StarterGui")
local InteractionController={};InteractionController.__index=InteractionController
function InteractionController.new(context)
 return setmetatable({context=context,connections={},coreGuiStates={}},InteractionController)
end
function InteractionController:mount(_playerGui)
 -- This adventure has no chat or leaderboard gameplay. Their default overlays
 -- cover the small-screen map and close button. Keep Roblox's menu/reporting,
 -- movement, jump, health and other platform controls unchanged.
 for _,kind in ipairs({Enum.CoreGuiType.Chat,Enum.CoreGuiType.PlayerList}) do
  local readOk,previous=pcall(function() return StarterGui:GetCoreGuiEnabled(kind) end)
  if readOk then
   local changed=pcall(function() StarterGui:SetCoreGuiEnabled(kind,false) end)
   if changed then self.coreGuiStates[kind]=previous else warn("LANTERN_OVERLAY_LAYOUT_UNCONFIRMED") end
  end
 end
 table.insert(self.connections,ProximityPromptService.PromptTriggered:Connect(function(prompt,player)
  if player~=self.context.player then return end
  local world=workspace:FindFirstChild("LanternIslandWorld")
  if not world or not prompt:IsDescendantOf(world) then return end
  local mid=prompt:GetAttribute("MissionId");if type(mid)=="string" then self.context.send("StartMission",{missionId=mid}) end
 end))
 table.insert(self.connections,ProximityPromptService.PromptShown:Connect(function(prompt)
  local mid=prompt:GetAttribute("MissionId")
  local owner=prompt.Parent and prompt.Parent.Parent and prompt.Parent.Parent:GetAttribute("OwnerUserId")
  if owner and owner~=self.context.player.UserId then prompt.Enabled=false end
  if type(mid)~="string" then return end
  local state=self.context.getState();local m=state and state.mission
  local index=prompt:GetAttribute("CheckpointIndex")
  prompt.ActionText=(m and m.missionId==mid and index~=m.checkpointIndex)
   and "Follow your next glow" or ("Open clue "..tostring(index or 1))
 end))
end
function InteractionController:destroy()
 for _,c in ipairs(self.connections) do c:Disconnect() end;self.connections={}
 for kind,previous in pairs(self.coreGuiStates) do
  pcall(function() StarterGui:SetCoreGuiEnabled(kind,previous) end)
 end
 self.coreGuiStates={}
end
return InteractionController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="19">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- One network owner and one lifecycle. Gameplay controllers subscribe through context.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local statusGui = Instance.new("ScreenGui")
statusGui.Name = "LanternIslandStartup"
statusGui.ResetOnSpawn = false
statusGui.IgnoreGuiInset = false
statusGui.Parent = playerGui
local status = Instance.new("TextLabel")
status.Name = "Status"
status.AnchorPoint = Vector2.new(0.5, 0)
status.Position = UDim2.fromScale(0.5, 0.03)
status.Size = UDim2.new(0.88, 0, 0, 110)
status.BackgroundColor3 = Color3.fromRGB(22, 42, 51)
status.TextColor3 = Color3.fromRGB(248, 245, 223)
status.Font = Enum.Font.GothamMedium
status.TextSize = 18
status.TextWrapped = true
status.Text = "Lantern Island\nConnecting to this development build..."
status.Parent = statusGui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 16)
corner.Parent = status
local retry = Instance.new("TextButton")
retry.Name = "RetryConnection"
retry.AnchorPoint = Vector2.new(0.5, 0)
retry.Position = UDim2.new(0.5, 0, 0.03, 118)
retry.Size = UDim2.fromOffset(200, 48)
retry.Font = Enum.Font.GothamMedium
retry.TextSize = 18
retry.Text = "Check connection"
retry.BackgroundColor3 = Color3.fromRGB(243, 195, 99)
retry.TextColor3 = Color3.fromRGB(22, 42, 51)
retry.Parent = statusGui
Instance.new("UICorner", retry).CornerRadius = UDim.new(0, 12)

local shared = ReplicatedStorage:WaitForChild("LanternIslandShared", 15)
if not shared then status.Text = "Lantern Island\nBuild connection unavailable. Rejoin this test build."; retry.Visible = false; return end
local module = shared:WaitForChild("Protocol", 15)
if not module then status.Text = "Lantern Island\nProtocol module missing. This build is incomplete."; retry.Visible = false; return end
local Protocol = require(module)
local remoteFolder = ReplicatedStorage:WaitForChild(Protocol.REMOTE_FOLDER, 15)
if not remoteFolder then status.Text = "Lantern Island\nServer unavailable. This is not a playable release."; retry.Visible = false; return end
local actionRemote = remoteFolder:WaitForChild(Protocol.ACTION_REMOTE, 10)
local stateRemote = remoteFolder:WaitForChild(Protocol.STATE_REMOTE, 10)
if not actionRemote or not actionRemote:IsA("RemoteEvent") or not stateRemote or not stateRemote:IsA("RemoteEvent") then
    status.Text = "Lantern Island\nNetwork components missing. This build is incomplete."; retry.Visible = false; return
end
local stateChanged = Instance.new("BindableEvent")
local resultReceived = Instance.new("BindableEvent")
local pendingChanged = Instance.new("BindableEvent")
local pending = nil
local uncertainRequestId = nil
local mountFailed = false
local sequence = 0
local latestState = nil
local controllers = {}
local context = {
    player = player, playerGui = playerGui, protocol = Protocol,
    stateChanged = stateChanged.Event, resultReceived = resultReceived.Event,
    pendingChanged = pendingChanged.Event,
}
context.getState = function() return latestState end
context.send = function(action, fields)
    if pending then return nil, "BUSY" end
    if uncertainRequestId and action ~= "GetState" then return nil, "REFRESH_REQUIRED" end
    fields = fields or {}
    local envelope = { requestId = HttpService:GenerateGUID(false), action = action,
        missionId = fields.missionId, itemId = fields.itemId, payload = fields.payload }
    local valid, code, clean = Protocol.validate(envelope)
    if not valid then return nil, code end
    pending = clean
    pendingChanged:Fire(true)
    actionRemote:FireServer(clean)
    task.delay(Protocol.REQUEST_TIMEOUT, function()
        if pending and pending.requestId == clean.requestId then
            pending = nil
            if clean.action ~= "GetState" then uncertainRequestId = clean.requestId end
            pendingChanged:Fire(false)
            -- An uncertain acknowledgment is NOT an unsuccessful transaction; never auto-resubmit.
            resultReceived:Fire({ requestId = clean.requestId, ok = false, code = "ACK_UNCONFIRMED" })
            statusGui.Enabled = true
            status.Text = "Lantern Island\nConnection interrupted. Check your current progress before trying again."
        end
    end)
    return clean.requestId, "SENT"
end
local function mountControllers()
    if controllers.UIController then return true end
    if mountFailed then return false end
    for _, name in ipairs({ "UIController", "InteractionController" }) do
        local found = script.Parent:FindFirstChild(name)
        if not found or not found:IsA("ModuleScript") then return false end
    end
    local created = {}
    local ok = pcall(function()
        for _, name in ipairs({ "UIController", "InteractionController", "SpellingController", "ReadingController", "FeedbackController" }) do
            local found = script.Parent:FindFirstChild(name)
            if found and found:IsA("ModuleScript") then
                local definition = require(found)
                assert(type(definition.new) == "function", name .. ".new required")
                local controller = definition.new(context)
                assert(type(controller.destroy) == "function", name .. ":destroy required")
                created[name] = controller
                if controller.mount then controller:mount(playerGui) end
            end
        end
        assert(type(created.UIController.render) == "function", "UIController:render required")
    end)
    if not ok then
        mountFailed = true
        for _, controller in pairs(created) do pcall(function() controller:destroy() end) end
        return false
    end
    controllers = created
    return true
end
stateRemote.OnClientEvent:Connect(function(packet)
    if type(packet) ~= "table" or type(packet.sequence) ~= "number" or packet.sequence <= sequence then return end
    sequence = packet.sequence
    local wasRefresh = pending and packet.requestId == pending.requestId and pending.action == "GetState"
    if pending and packet.requestId == pending.requestId then pending = nil; pendingChanged:Fire(false) end
    if packet.requestId == uncertainRequestId or (wasRefresh and type(packet.state) == "table" and packet.state.mutationPending == false) then
        uncertainRequestId = nil
    end
    if type(packet.state) == "table" then latestState = packet.state end
    if latestState and latestState.runtimeStatus == "READY" and latestState.profileStatus == "LOADED" then
        if mountControllers() then
            local rendered = pcall(function() controllers.UIController:render(latestState) end)
            statusGui.Enabled = not rendered
            if not rendered then status.Text = "Lantern Island\nThe interface could not update. Please rejoin this test build." end
        else
            statusGui.Enabled = true
            status.Text = "Lantern Island\nGameplay controls are not integrated yet. This is a development build."
        end
    else
        statusGui.Enabled = true
        local text = latestState and latestState.runtimeStatus or "STATE_UNAVAILABLE"
        if latestState and latestState.runtimeStatus == "READY" then text = latestState.profileStatus end
        status.Text = "Lantern Island\nDevelopment status: " .. tostring(text) .. "\nYour existing StarBlox game is unchanged."
    end
    stateChanged:Fire(latestState)
    resultReceived:Fire({ requestId = packet.requestId, ok = packet.ok == true, code = packet.code })
end)
retry.Activated:Connect(function() context.send("GetState") end)
player.CharacterAdded:Connect(function() context.send("GetState") end)
context.send("GetState")
script.Destroying:Connect(function()
    for _, controller in pairs(controllers) do pcall(function() controller:destroy() end) end
    stateChanged:Destroy(); resultReceived:Destroy(); pendingChanged:Destroy(); statusGui:Destroy()
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">RewardJourney</string>
            <string name="Source">--!nonstrict
-- Pure presentation model. Only server-confirmed inventory drives celebrations.
-- No random prizes, expiring streaks, lost lives, purchases, or mastery claims.
local Journey={}
Journey.catalog={
 {id="firefly-scarf",title="Firefly Scarf",quest="Light the hill",color={255,207,116},message="You brought the hill's warm glow back!"},
 {id="rainbow-bow",title="Rainbow Bow",quest="Ribbon studio",color={244,163,205},message="Your word clues made the ribbon studio shine!"},
 {id="moon-crown",title="Moon Crown",quest="Missing picnic",color={175,190,255},message="You followed the story and found the picnic!"},
}
for _,item in ipairs(Journey.catalog) do table.freeze(item.color);table.freeze(item) end
table.freeze(Journey.catalog)
function Journey.item(id)
 for _,item in ipairs(Journey.catalog) do if item.id==id then return item end end
 return nil
end
function Journey.collection(profile)
 local seen={};local count=0
 if type(profile)=="table" and type(profile.ownedItemIds)=="table" then
  for _,id in ipairs(profile.ownedItemIds) do if Journey.item(id) and not seen[id] then seen[id]=true;count+=1 end end
 end
 return {count=count,total=3,owned=seen,bonusUnlocked=count==3}
end
function Journey.progress(mission,profile)
 local item=Journey.item(mission and mission.rewardItemId)
 if not item then return {solved=0,total=4,title="Choose an adventure",owned=false,practice=false} end
 local owned=Journey.collection(profile).owned[item.id]==true
 local index=tonumber(mission.checkpointIndex) or 1
 local solved=math.clamp(math.floor(index)-1,0,4)
 if mission.status=="COMPLETED" then solved=4 end
 return {solved=solved,total=4,title=item.title,itemId=item.id,owned=owned,practice=mission.practice==true}
end
function Journey.newObserver()
 local initialized=false;local known={};local mostClues=0;local bonusSeen=false
 local observer={}
 function observer:observe(state)
  if type(state)~="table" or state.runtimeStatus~="READY" or state.profileStatus~="LOADED" or type(state.profile)~="table" or type(state.mission)~="table" then return {} end
  local collection=Journey.collection(state.profile)
  local clues=math.clamp(tonumber(state.mission.completedCount) or 0,0,12)
  if not initialized then
   initialized=true;known=collection.owned;mostClues=clues;bonusSeen=collection.bonusUnlocked
   return {} -- A reconnect is not a new reward.
  end
  local events={}
  for _,item in ipairs(Journey.catalog) do
   if collection.owned[item.id] and not known[item.id] then
    known[item.id]=true;table.insert(events,{kind="unlock",itemId=item.id})
   end
  end
  if collection.bonusUnlocked and not bonusSeen then bonusSeen=true;table.insert(events,{kind="collection",count=3}) end
  if clues&gt;mostClues and #events==0 and not state.mission.practice then
   table.insert(events,{kind="checkpoint",solved=Journey.progress(state.mission,state.profile).solved,itemId=state.mission.rewardItemId,missionId=state.mission.missionId})
  end
  mostClues=math.max(mostClues,clues)
  return events
 end
 return observer
end
return table.freeze(Journey)</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">RewardView</string>
            <string name="Source">--!nonstrict
-- Reward presentation is cosmetic. It never sends a grant or edits a profile.
local TweenService=game:GetService("TweenService")
local GuiService=game:GetService("GuiService")
local Journey=require(script.Parent:WaitForChild("RewardJourney"))
local View={};View.__index=View
local INK=Color3.fromRGB(43,53,78)
local GOLD=Color3.fromRGB(255,214,123)
local CREAM=Color3.fromRGB(255,250,244)
local function round(parent,r) Instance.new("UICorner",parent).CornerRadius=UDim.new(0,r) end
local function reducedMotion()
 local ok,value=pcall(function() return GuiService.ReducedMotionEnabled end)
 return ok and value==true
end
function View.new(context)
 return setmetatable({context=context,observer=Journey.newObserver(),connections={},tweens={},destroyed=false,serial=0},View)
end
function View:mount(ui)
 self.ui=ui
 local rail=Instance.new("Frame");rail.Name="RewardProgress";rail.BackgroundTransparency=1;rail.Position=UDim2.fromOffset(0,72);rail.Size=UDim2.new(1,0,0,24);rail.Parent=ui.tracker;self.rail=rail
 local label=Instance.new("TextLabel");label.Name="NextReward";label.Position=UDim2.fromOffset(67,0);label.Size=UDim2.new(1,-67,1,0);label.BackgroundTransparency=1;label.TextColor3=CREAM;label.Font=Enum.Font.GothamMedium;label.TextSize=12;label.TextXAlignment=Enum.TextXAlignment.Left;label.TextWrapped=true;label.Parent=rail;self.label=label
 self.glows={}
 for i=1,4 do local glow=Instance.new("Frame");glow.Name="Glow"..i;glow.Position=UDim2.fromOffset((i-1)*15,7);glow.Size=UDim2.fromOffset(10,10);glow.Rotation=45;glow.BackgroundColor3=GOLD;glow.BackgroundTransparency=.8;glow.BorderSizePixel=0;glow.Parent=rail;round(glow,3);table.insert(self.glows,glow) end
 local effects=Instance.new("Frame");effects.Name="RewardEffects";effects.Size=UDim2.fromScale(1,1);effects.BackgroundTransparency=1;effects.Active=false;effects.ZIndex=20;effects.Parent=ui.gui;self.effects=effects
 local banner=Instance.new("TextLabel");banner.Name="RewardCelebration";banner.AnchorPoint=Vector2.new(.5,0);banner.Position=UDim2.new(.5,0,0,68);banner.Size=UDim2.new(.84,0,0,60);banner.BackgroundColor3=INK;banner.TextColor3=CREAM;banner.TextWrapped=true;banner.Font=Enum.Font.GothamBold;banner.TextSize=17;banner.ZIndex=22;banner.Visible=false;banner.Active=false;banner.Parent=effects;round(banner,16);self.banner=banner
 table.insert(self.connections,self.context.stateChanged:Connect(function(state) self:_state(state) end))
 -- Prime from the actual loaded snapshot; never replay old unlocks on join.
 self:_state(self.context.getState())
end
function View:_state(state)
 if self.destroyed or not state or not state.mission then return end
 self:updateProgress(state)
 local events=self.observer:observe(state)
 if #events==0 then return end
 local last=events[#events]
 if last.kind=="collection" then self:celebrate("The whole collection is yours!\nPip's Starlight Trail is unlocked.",true)
 elseif last.kind=="unlock" then
  local item=Journey.item(last.itemId);self:celebrate(item.title.." unlocked!\n"..item.message,true)
 elseif last.kind=="checkpoint" then
  local messages={["firefly-scarf"]="The hill glows brighter!",["rainbow-bow"]="The ribbon studio is coming alive!",["moon-crown"]="The picnic trail is waking up!"}
  self:celebrate((messages[last.itemId] or "The island changed!").."\n"..last.solved.." of 4 clues restored.",false)
 end
end
function View:updateProgress(state)
 local progress=Journey.progress(state.mission,state.profile)
 local count=progress.owned and not progress.practice and 4 or progress.solved
 self.rail:SetAttribute("Solved",count);self.rail:SetAttribute("RewardId",progress.itemId or "")
 self.label.Text=progress.practice and (progress.solved.."/4  Practice - outfit yours") or (progress.owned and (progress.title.." - yours!") or (progress.solved.."/4  "..progress.title))
 for i,glow in ipairs(self.glows) do glow.BackgroundTransparency=i&lt;=count and 0 or .8 end
end
function View:celebrate(message,big)
 if self.destroyed then return end
 self.serial+=1;local serial=self.serial
 self.banner.Text=message;self.banner.Visible=true;self.banner:SetAttribute("CelebrationCount",(self.banner:GetAttribute("CelebrationCount") or 0)+1)
 for _,tween in ipairs(self.tweens) do tween:Cancel() end;self.tweens={}
 for _,child in ipairs(self.effects:GetChildren()) do if child~=self.banner then child:Destroy() end end
 if not reducedMotion() then
  for i=1,(big and 14 or 6) do
   local particle=Instance.new("Frame");particle.Name="RewardSpark";particle.Size=UDim2.fromOffset(big and 9 or 6,big and 9 or 6);particle.AnchorPoint=Vector2.new(.5,.5);particle.Position=UDim2.new(.5,0,0,112);particle.Rotation=45;particle.BorderSizePixel=0;particle.BackgroundColor3=i%2==0 and GOLD or Color3.fromRGB(244,163,205);particle.Active=false;particle.ZIndex=21;particle.Parent=self.effects;round(particle,2)
   local angle=i*2.399;local target=UDim2.new(.5,math.cos(angle)*(big and 145 or 85),0,112+math.sin(angle)*65+50)
   local tween=TweenService:Create(particle,TweenInfo.new(.8,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=target,BackgroundTransparency=1,Rotation=110+i*17});table.insert(self.tweens,tween);tween:Play()
  end
 end
 task.delay(big and 3.5 or 1.8,function()
  if self.destroyed or self.serial~=serial then return end
  self.banner.Visible=false
  for _,child in ipairs(self.effects:GetChildren()) do if child~=self.banner then child:Destroy() end end
  self.tweens={}
 end)
end
function View:_preview(ui,itemId)
 local source=workspace:FindFirstChild("LanternIslandWorld")
 source=source and source:FindFirstChild("Pip_"..self.context.player.UserId)
 if not source then return end -- Text reward and equip still work if pet replication is late.
 local viewport=Instance.new("ViewportFrame");viewport.Name="RewardPreview";viewport.Size=UDim2.new(1,0,0,154);viewport.LayoutOrder=-5;viewport.BackgroundColor3=Color3.fromRGB(231,225,247);viewport.Ambient=Color3.fromRGB(225,225,240);viewport.LightColor=Color3.new(1,1,1);viewport.LightDirection=Vector3.new(-1,-1,-2);viewport.Active=false;viewport.Parent=ui.scroll;round(viewport,16)
 local model=source:Clone();model.Name="PreviewPip"
 for _,inst in ipairs(model:GetDescendants()) do
  if inst:IsA("LuaSourceContainer") or inst:IsA("ProximityPrompt") or inst:IsA("BillboardGui") or inst:IsA("Trail") or inst:IsA("ParticleEmitter") then inst:Destroy()
  elseif inst:IsA("BasePart") then inst.Anchored=true;inst.CanCollide=false;if Journey.item(inst.Name) then inst.Transparency=inst.Name==itemId and 0 or 1 end end
 end
 model.Parent=viewport;model:PivotTo(CFrame.Angles(0,math.rad(-18),0))
 local camera=Instance.new("Camera");camera.FieldOfView=33;camera.CFrame=CFrame.lookAt(Vector3.new(0,1,-8.2),Vector3.new(0,.2,0));camera.Parent=viewport;viewport.CurrentCamera=camera
 viewport:SetAttribute("ItemId",itemId or "")
end
function View:decorate(ui)
 if self.destroyed or not ui.state or not ui.state.mission then return end
 local state=ui.state;local m=state.mission;local collection=Journey.collection(state.profile)
 self:updateProgress(state)
 if ui.mode=="quest" and m.status=="COMPLETED" then
  local item=Journey.item(m.rewardItemId)
  if item and collection.owned[item.id] then
   local title=ui:_addText("RewardRevealTitle",m.practice and ("Your "..item.title) or (item.title.." is yours!"),21);title.LayoutOrder=-6;title.Font=Enum.Font.GothamBold
   self:_preview(ui,item.id)
   ui:_addText("RewardCollectionGoal",collection.bonusUnlocked and "Collection complete! Pip leaves a Starlight Trail when moving.\nTake a little victory walk together." or (collection.count.."/3 outfits collected. Collect all three to unlock Pip's Starlight Trail."),16)
   if state.profile.saveStatus~="SAVED" and state.profile.saveStatus~="LOADED" then
    ui:_addText("RewardSaveScope",state.profile.saveStatus=="STUDIO_SESSION_ONLY" and "Studio practice: your collection lasts while this test server stays open." or "Reward earned in this session; saving is not confirmed yet.",13)
   end
  end
 elseif ui.mode=="wardrobe" then
  local itemId=state.profile and state.profile.equippedItemId
  if Journey.item(itemId) then self:_preview(ui,itemId) end
  local t=ui:_addText("CollectionProgress",collection.count.." / 3 outfits in your collection",18);t.LayoutOrder=-6;t.Font=Enum.Font.GothamBold
  ui:_addText("CollectionBonus",collection.bonusUnlocked and "BONUS UNLOCKED: Starlight Trail\nPip's trail comes with the whole collection. No extra coins or purchases." or "Your collection bonus: Pip's Starlight Trail.\nEarn all three outfits. Hints are always welcome and never reduce your prize.",16)
 elseif ui.mode=="map" then
  local restored=collection.count.." / 3 adventures restored"
  ui:_addText("IslandRestoration",restored,18).Font=Enum.Font.GothamBold
  ui:_addText("AdventureRewardGoal",collection.bonusUnlocked and "The Starlight Garden is awake! Replay any trail for fresh practice questions." or "Four clues transform a trail and earn its outfit. Restore all three to wake the Starlight Garden. Take breaks whenever you like.",16)
 end
end
function View:destroy()
 self.destroyed=true
 for _,c in ipairs(self.connections) do c:Disconnect() end
 for _,t in ipairs(self.tweens) do t:Cancel() end
 self.connections={};self.tweens={}
 if self.effects then self.effects:Destroy() end
 if self.rail then self.rail:Destroy() end
end
return View</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source">--!nonstrict
local RunService=game:GetService("RunService")
local UserInputService=game:GetService("UserInputService")
local UIModel=require(script.Parent:WaitForChild("UIModel"))
local RewardView=require(script.Parent:WaitForChild("RewardView"))
local UIController={};UIController.__index=UIController
local DARK=Color3.fromRGB(43,53,78);local WHITE=Color3.fromRGB(255,250,244);local PINK=Color3.fromRGB(246,180,207);local GOLD=Color3.fromRGB(255,214,123);local MINT=Color3.fromRGB(187,232,208);local BLUE=Color3.fromRGB(177,220,239)
local function corner(gui,r) Instance.new("UICorner",gui).CornerRadius=UDim.new(0,r or 14) end
local function text(parent,name,value,size)
 local t=Instance.new("TextLabel");t.Name=name;t.BackgroundTransparency=1;t.Size=UDim2.new(1,0,0,0);t.AutomaticSize=Enum.AutomaticSize.Y;t.Font=Enum.Font.GothamMedium;t.TextSize=size or 17;t.TextColor3=DARK;t.TextWrapped=true;t.TextXAlignment=Enum.TextXAlignment.Left;t.TextYAlignment=Enum.TextYAlignment.Top;t.Text=value;t.Parent=parent;return t
end
local function button(parent,name,value,color)
 local b=Instance.new("TextButton");b.Name=name;b.Size=UDim2.new(1,0,0,48);b.Font=Enum.Font.GothamBold;b.TextSize=17;b.TextWrapped=true;b.TextColor3=DARK;b.Text=value;b.BackgroundColor3=color or GOLD;b.AutoButtonColor=true;b.BorderSizePixel=0;b.Parent=parent;corner(b,13)
 local stroke=Instance.new("UIStroke");stroke.Color=DARK;stroke.Transparency=.82;stroke.Thickness=1.1;stroke.Parent=b
 local base=b.BackgroundColor3;local gradient=Instance.new("UIGradient");gradient.Color=ColorSequence.new(base:Lerp(WHITE,.18),base);gradient.Rotation=90;gradient.Parent=b
 return b
end
local function pad(parent,n)
 local p=Instance.new("UIPadding");p.PaddingTop=UDim.new(0,n);p.PaddingBottom=UDim.new(0,n);p.PaddingLeft=UDim.new(0,n);p.PaddingRight=UDim.new(0,n);p.Parent=parent
end
function UIController.new(context) return setmetatable({context=context,connections={},contentConnections={},mode=nil,state=nil,pending=false,toastSerial=0,welcomed=false},UIController) end
function UIController:_connect(signal,callback,content)
 local c=signal:Connect(callback);table.insert(content and self.contentConnections or self.connections,c);return c
end
function UIController:_send(action,fields)
 local id,code=self.context.send(action,fields)
 if not id then self:showToast(code=="BUSY" and "Pip is checking that..." or "Please check the connection, then try again.") end
 return id
end
function UIController:_command(command)
 if not command then return end
 if command.menu then self.mode=command.menu;self:_draw();return end
 self:_send(command.action,command.fields)
end
function UIController:mount(playerGui)
 local gui=Instance.new("ScreenGui");gui.Name="LanternIslandUI";gui.ResetOnSpawn=false;gui.IgnoreGuiInset=false;gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling;gui.Parent=playerGui;self.gui=gui
 local tracker=Instance.new("Frame");tracker.Name="AdventureTracker";tracker.Position=UDim2.fromOffset(12,8);tracker.Size=UDim2.fromOffset(290,120);tracker.BackgroundColor3=DARK;tracker.BackgroundTransparency=.04;tracker.BorderSizePixel=0;tracker.Parent=gui;corner(tracker,18);pad(tracker,12);self.tracker=tracker
 local trackerStroke=Instance.new("UIStroke");trackerStroke.Color=Color3.fromRGB(121,142,181);trackerStroke.Transparency=.55;trackerStroke.Thickness=1.2;trackerStroke.Parent=tracker
 local trackerGradient=Instance.new("UIGradient");trackerGradient.Color=ColorSequence.new(DARK:Lerp(BLUE,.12),DARK);trackerGradient.Rotation=120;trackerGradient.Parent=tracker
 local name=text(tracker,"Title","Pip's Island",19);name.TextColor3=WHITE;name.Size=UDim2.new(1,0,0,23);name.AutomaticSize=Enum.AutomaticSize.None
 local objective=text(tracker,"Objective","Pick a trail and explore with Pip.",14);objective.Position=UDim2.fromOffset(0,27);objective.Size=UDim2.new(1,0,0,40);objective.AutomaticSize=Enum.AutomaticSize.None;objective.TextColor3=WHITE;self.trackerText=objective
 local open=button(tracker,"OpenClue","Open clue",GOLD);open.Position=UDim2.fromOffset(0,98);open.Size=UDim2.new(1,0,0,36);open.TextSize=15;self.open=open
 local nav=Instance.new("Frame");nav.Name="ExploreButtons";nav.BackgroundTransparency=1;nav.Position=UDim2.fromOffset(12,136);nav.Size=UDim2.fromOffset(290,42);nav.Parent=gui;self.nav=nav
 for i,entry in ipairs({{"map","Adventures"},{"wardrobe","Dress Pip"},{"journal","Journal"}}) do
  local b=button(nav,entry[1],entry[2],i==2 and PINK or MINT);b.Size=UDim2.new(1/3,-5,1,0);b.Position=UDim2.new((i-1)/3,0,0,0);b.TextSize=13
  self:_connect(b.Activated,function() self.mode=self.mode==entry[1] and nil or entry[1];self:_draw() end)
 end
 local panel=Instance.new("Frame");panel.Name="ContextCard";panel.BackgroundColor3=WHITE;panel.BorderSizePixel=0;panel.Visible=false;panel.Parent=gui;corner(panel,20);self.panel=panel
 local panelStroke=Instance.new("UIStroke");panelStroke.Color=DARK;panelStroke.Transparency=.78;panelStroke.Thickness=1.1;panelStroke.Parent=panel
 local title=text(panel,"CardTitle","Adventure",20);title.Position=UDim2.fromOffset(16,14);title.Size=UDim2.new(1,-76,0,44);title.AutomaticSize=Enum.AutomaticSize.None;title.Font=Enum.Font.GothamBold;self.heading=title
 local close=button(panel,"CloseCard","X",PINK);close.AnchorPoint=Vector2.new(1,0);close.Position=UDim2.new(1,-10,0,10);close.Size=UDim2.fromOffset(44,44);self.close=close
 local scroll=Instance.new("ScrollingFrame");scroll.Name="CardContent";scroll.BackgroundTransparency=1;scroll.BorderSizePixel=0;scroll.Position=UDim2.fromOffset(14,66);scroll.Size=UDim2.new(1,-28,1,-132);scroll.CanvasSize=UDim2.new();scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y;scroll.ScrollBarThickness=5;scroll.ScrollingDirection=Enum.ScrollingDirection.Y;scroll.Parent=panel;self.scroll=scroll
 local layout=Instance.new("UIListLayout");layout.Padding=UDim.new(0,12);layout.SortOrder=Enum.SortOrder.LayoutOrder;layout.Parent=scroll;self.contentLayout=layout
 local primary=button(panel,"PrimaryAction","Continue",GOLD);primary.Position=UDim2.new(0,14,1,-58);primary.Size=UDim2.new(1,-28,0,46);self.primary=primary
 local toast=Instance.new("TextLabel");toast.Name="PipFeedback";toast.AnchorPoint=Vector2.new(.5,0);toast.Position=UDim2.new(.5,0,0,6);toast.Size=UDim2.new(.74,0,0,62);toast.BackgroundColor3=DARK;toast.TextColor3=WHITE;toast.TextWrapped=true;toast.Font=Enum.Font.GothamBold;toast.TextSize=16;toast.Visible=false;toast.ZIndex=15;toast.Parent=gui;corner(toast,16);self.toast=toast
 self:_connect(open.Activated,function()
  local m=self.state and self.state.mission
  if m and (m.status=="ACTIVE" or m.status=="BETWEEN" or m.status=="COMPLETED") then self.mode="quest";self:_draw()
  else self:_command(UIModel.primary(self.state)) end
 end)
 self:_connect(close.Activated,function()
  if self.mode=="quest" and self.state and self.state.mission.status=="ACTIVE" then self:_send("CancelMission",{missionId=self.state.mission.missionId}) end
  self.mode=nil;self:_draw()
 end)
 self:_connect(primary.Activated,function()
  if self.mode=="quest" then
   local m=self.state.mission
   if m.status=="ACTIVE" then self:_send("RequestHint",{missionId=m.missionId})
   else local command=UIModel.primary(self.state);if m.status=="BETWEEN" then self.mode=nil end;self:_command(command) end
  else self.mode=nil;self:_draw() end
 end)
 self:_connect(self.context.pendingChanged,function(value) self.pending=value;self:_pending() end)
 self:_connect(self.context.resultReceived,function(result)
  local messages={TRY_AGAIN="Let's try another way. Pip added a clue.",CHECKPOINT_COMPLETE="A glow is back! Find the next one.",MISSION_COMPLETE="You helped Pip! A new outfit is yours.",PRACTICE_COMPLETE="Nice practice! Your outfits are still yours.",ITEM_EQUIPPED="Looking good, Pip!",FOLLOW_BEACON="Follow the glowing marker to your next clue.",PROGRESS_SAVE_PENDING="That worked, but saving is not confirmed yet.",ACK_UNCONFIRMED="Connection interrupted. Check progress before trying again.",ACTION_FAILED="That action did not finish. Please try again.",PROFILE_NOT_READY="Your progress is still loading."}
  if messages[result.code] then self:showToast(messages[result.code]) end
 end)
 local tick=0
 self:_connect(RunService.RenderStepped,function(dt)
  tick+=dt;if tick&lt;.2 then return end;tick=0;self:_layout();self:_track()
 end)
 self.rewards=RewardView.new(self.context);self.rewards:mount(self)
 self:_layout()
end
function UIController:_layout()
 local camera=workspace.CurrentCamera;if not camera or not self.panel then return end
 local v=camera.ViewportSize;local l=UIModel.layout(v.X,v.Y,UserInputService.TouchEnabled)
 self.touchLayout=l.mobile
 self.panel.Size=UDim2.fromOffset(l.width,l.height);self.panel.AnchorPoint=Vector2.new(l.center and .5 or 1,0)
 self.panel.Position=l.center and UDim2.new(.5,0,0,l.top) or UDim2.new(1,-12,0,l.top)
 self.tracker.Size=UDim2.fromOffset(l.trackerWidth,l.trackerHeight)
 self.open.Position=UDim2.fromOffset(0,l.trackerHeight-l.openHeight-24);self.open.Size=UDim2.new(1,0,0,l.openHeight);self.open.TextSize=l.mobile and 16 or 15
 self.nav.Size=UDim2.fromOffset(l.trackerWidth,l.navHeight);self.nav.Position=UDim2.fromOffset(12,l.trackerHeight+14)
 self.close.Size=UDim2.fromOffset(l.closeSize,l.closeSize)
 self.heading.Size=UDim2.new(1,-(l.closeSize+32),0,44)
 self.primary.Size=UDim2.new(1,-28,0,l.primaryHeight);self.primary.Position=UDim2.new(0,14,1,-(l.primaryHeight+12))
 self.scroll.Size=UDim2.new(1,-28,1,-(l.primaryHeight+86));self.scroll.ScrollBarThickness=l.mobile and 7 or 5
 for _,b in ipairs(self.nav:GetChildren()) do if b:IsA("TextButton") then b.TextSize=l.mobile and 14 or 13 end end
 -- Keep exploration controls clear when a narrow portrait card is open.
 self.tracker.Visible=not (l.center and self.panel.Visible);self.nav.Visible=self.tracker.Visible
end
function UIController:_track()
 local m=self.state and self.state.mission;if not m then return end
 local world=workspace:FindFirstChild("LanternIslandWorld");local targetName=UIModel.target(m);local target=world and targetName and world:FindFirstChild(targetName)
 local root=self.context.player.Character and self.context.player.Character:FindFirstChild("HumanoidRootPart")
 local distance=root and target and math.floor((root.Position-target.Position).Magnitude) or nil
 self.trackerText.Text=m.title.."  "..(m.checkpointIndex or 1).."/"..(m.checkpointTotal or 4).."\n"..(m.status=="COMPLETED" and "Outfit earned! Dress Pip or explore." or ((distance and distance&lt;=11) and "You're here! Open the clue." or "Follow your glow"..(distance and " - "..distance.." steps" or "")))
 if not self.highlight then local h=Instance.new("Highlight");h.Name="MyNextClue";h.FillColor=GOLD;h.OutlineColor=WHITE;h.FillTransparency=.55;h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop;h.Parent=self.gui;self.highlight=h end
 self.highlight.Adornee=target;self.highlight.Enabled=target~=nil and m.status~="COMPLETED"
 self.open.Text=m.status=="COMPLETED" and "See my reward" or (m.status=="BETWEEN" and "Pip's discovery" or "Open clue")
end
function UIController:_clear()
 for _,c in ipairs(self.contentConnections) do c:Disconnect() end;self.contentConnections={}
 for _,child in ipairs(self.scroll:GetChildren()) do if child~=self.contentLayout then child:Destroy() end end
 self.order=0;self.scroll.CanvasPosition=Vector2.zero
end
function UIController:_addText(name,value,size)
 self.order+=1;local t=text(self.scroll,name,value,size);t.LayoutOrder=self.order;return t
end
function UIController:_addButton(name,value,color,callback,enabled)
 self.order+=1;local b=button(self.scroll,name,value,color);b.LayoutOrder=self.order;b:SetAttribute("ActionEnabled",enabled~=false)
 if self.touchLayout then b.Size=UDim2.new(1,0,0,54);b.TextSize=18 end
 self:_connect(b.Activated,function() if b:GetAttribute("ActionEnabled") and not self.pending then callback() end end,true);return b
end
function UIController:_blocks(r)
 if type(r.tensA)~="number" then return end
 self:_addText("PlaceValue","Look at the tens and ones:",15)
 for i,pair in ipairs({{r.tensA,r.onesA},{r.tensB,r.onesB}}) do
  local frame=Instance.new("Frame");frame.Name="StoneGroups"..i;frame.Size=UDim2.new(1,0,0,54);frame.BackgroundColor3=MINT;frame.BackgroundTransparency=.45;self.order+=1;frame.LayoutOrder=self.order;frame.Parent=self.scroll;corner(frame,10)
  local t=text(frame,"GroupLabel",pair[1].." tens + "..pair[2].." ones",14);t.Position=UDim2.fromOffset(8,3)
  for j=1,pair[1] do local bar=Instance.new("Frame");bar.Size=UDim2.fromOffset(10,22);bar.Position=UDim2.fromOffset(10+(j-1)*15,26);bar.BackgroundColor3=DARK;bar.Parent=frame;corner(bar,3) end
  for j=1,pair[2] do local dot=Instance.new("Frame");dot.Size=UDim2.fromOffset(8,8);dot.Position=UDim2.fromOffset(88+(j-1)*12,33);dot.BackgroundColor3=DARK;dot.Parent=frame;corner(dot,5) end
 end
end
function UIController:_draw()
 if not self.panel or not self.state or not self.state.mission then return end
 self.panel.Visible=self.mode~=nil;self:_layout();self:_track();if not self.mode then return end
 self:_clear();self.primary.Text="Back to exploring"
 local state=self.state;local m=state.mission;local profile=state.profile
 if self.mode=="map" then
  self.heading.Text="Pick your adventure"
  self:_addText("Invitation","Pick a trail with Pip. Every solved clue changes the island, and completed adventures stay transformed.",17)
  local rewardNames={["firefly-scarf"]="Firefly Scarf",["rainbow-bow"]="Rainbow Bow",["moon-crown"]="Moon Crown"}
  for _,q in ipairs(UIModel.quests) do
   local owned=UIModel.owns(profile,q.reward);local color=q.id=="lantern-lift" and GOLD or (q.id=="ribbon-studio" and PINK or BLUE)
   local symbol=q.id=="lantern-lift" and "✦" or (q.id=="ribbon-studio" and "Aa" or "☾")
   local detail=owned and ("Restored ✓  •  Fresh practice available") or ("Earn "..(rewardNames[q.reward] or "an outfit").."  •  Change the island")
   local b=self:_addButton("Quest_"..q.id,symbol.."   "..q.title.."\n      "..q.subtitle.."  •  "..detail,color,function() self.mode=nil;self:_send("StartMission",{missionId=q.id});self:_draw() end)
   b.Size=UDim2.new(1,0,0,64);b.TextXAlignment=Enum.TextXAlignment.Left
   local inset=Instance.new("UIPadding");inset.PaddingLeft=UDim.new(0,14);inset.PaddingRight=UDim.new(0,10);inset.Parent=b
  end
 elseif self.mode=="wardrobe" then
  self.heading.Text="Pip's dress-up box"
  self:_addText("OutfitIntro","Your adventure rewards are free. Choose one for your very own Pip.",17)
  for _,item in ipairs(UIModel.items) do
   local owned=UIModel.owns(profile,item.id);local equipped=profile and profile.equippedItemId==item.id
   self:_addButton("Outfit_"..item.id,item.title..(equipped and "  [wearing]" or (owned and "  - Wear it!" or "\nEarn in "..item.quest)),owned and PINK or MINT,function() self:_send("EquipItem",{itemId=item.id}) end,owned and not equipped)
  end
 elseif self.mode=="journal" then
  self.heading.Text="Practice journal"
  self:_addText("Counts",(m.completedCount or 0).." clues solved\n"..(m.independentCount or 0).." first-try answers without hints\n"..(m.supportedCount or 0).." answers with help or retries\n"..(m.transferCount or 0).." new final clues solved first try",17)
  self:_addText("EvidenceLimit","These are practice results, not a mastery score. Replaying familiar clues does not add new learning credit.",16)
  self:_addText("Source",state.lesson and state.lesson.sourceLabel or "Original sample practice - not current homework",14)
  self:_addText("SaveState",UIModel.saveText(profile and profile.saveStatus),14)
 else
  self.heading.Text=m.title
  if m.practice then self:_addText("ReplayLabel","Practice replay - no extra stars or new learning credit",14) end
  if m.status=="ACTIVE" then
   self:_addText("Passage",m.passage or "",17);self:_addText("Question",m.prompt or "",20);self:_blocks(m.representation or {})
   if m.hint and m.hint~="" then self:_addText("PipHint","Pip's clue: "..m.hint,17) end
   for _,option in ipairs(m.options or {}) do self:_addButton("Answer_"..option.id,option.label,GOLD,function() self:_command(UIModel.answer(self.state,option.id)) end) end
   self.primary.Text=m.hint~="" and "Another clue, Pip" or "Help me, Pip"
  else
   self:_addText("Explanation",m.objective or "",18)
   if m.status=="COMPLETED" then
    self:_addText("RewardMessage",m.practice and "Great practicing! Your original rewards are safe." or "A new outfit is in your dress-up box.",17)
    self:_addButton("ReplayQuest","Practice this adventure again",MINT,function() self.mode=nil;self:_send("StartMission",{missionId=m.missionId});self:_draw() end)
   elseif m.status=="BETWEEN" then self:_addText("NextHint","Time to explore! Follow the next glowing marker.",17) end
   local command=UIModel.primary(state);self.primary.Text=command and command.label or "Continue"
  end
 end
 if self.rewards then self.rewards:decorate(self) end
 self:_pending()
end
function UIController:_pending()
 if not self.gui then return end
 for _,b in ipairs(self.scroll:GetChildren()) do if b:IsA("TextButton") then b.Active=not self.pending and b:GetAttribute("ActionEnabled")~=false;b.AutoButtonColor=b.Active;b.TextTransparency=b.Active and 0 or .35 end end
 self.primary.Active=not self.pending;self.primary.AutoButtonColor=not self.pending;self.open.Active=not self.pending
end
function UIController:render(state)
 local previous=self.state and self.state.mission;self.state=state;local m=state and state.mission
 if not self.welcomed and state and state.profileStatus=="LOADED" and m then
  self.welcomed=true
  local owned=state.profile and state.profile.ownedItemIds or {}
  if #owned==0 and (m.completedCount or 0)==0 and m.status=="AVAILABLE" then
   self.mode="map"
   task.delay(.2,function() if self.gui and self.mode=="map" then self:showToast("Pip found three glowing trails. Pick the one that looks fun!") end end)
  end
 end
 if m and (m.status=="ACTIVE" or m.status=="BETWEEN" or m.status=="COMPLETED") and (not previous or previous.status~=m.status or previous.missionId~=m.missionId or previous.activityId~=m.activityId) then self.mode="quest" end
 if m and m.status=="AVAILABLE" and self.mode=="quest" then self.mode=nil end
 self:_draw()
end
function UIController:showToast(message)
 if not self.toast then return end;self.toastSerial+=1;local serial=self.toastSerial;self.toast.Text=message;self.toast.Visible=true
 task.delay(3.2,function() if self.toast and self.toastSerial==serial then self.toast.Visible=false end end)
end
function UIController:destroy()
 if self.rewards then self.rewards:destroy() end
 for _,c in ipairs(self.connections) do c:Disconnect() end;for _,c in ipairs(self.contentConnections) do c:Disconnect() end
 if self.gui then self.gui:Destroy() end
end
return UIController</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">UIModel</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Pure view/action model shared by production controls and behavior tests.
local UIModel={}
UIModel.quests={
 {id="lantern-lift",title="Light the hill",subtitle="Glowstone math",reward="firefly-scarf",station="LiftConsole"},
 {id="ribbon-studio",title="Ribbon studio",subtitle="Word clues",reward="rainbow-bow",station="RibbonConsole"},
 {id="moon-picnic",title="Missing picnic",subtitle="Reading mystery",reward="moon-crown",station="PicnicConsole"},
}
UIModel.items={
 {id="firefly-scarf",title="Firefly Scarf",quest="Light the hill"},
 {id="rainbow-bow",title="Rainbow Bow",quest="Ribbon studio"},
 {id="moon-crown",title="Moon Crown",quest="Missing picnic"},
}
function UIModel.owns(profile,id)
 for _,owned in ipairs(profile and profile.ownedItemIds or {}) do if owned==id then return true end end
 return false
end
function UIModel.primary(state)
 local m=state and state.mission;if not m then return nil end
 if m.status=="COMPLETED" then
  if UIModel.owns(state.profile,m.rewardItemId) and state.profile.equippedItemId~=m.rewardItemId then return {label="Dress Pip in your reward",action="EquipItem",fields={itemId=m.rewardItemId}} end
  return {label="Choose another adventure",menu="map"}
 end
 return {label=m.status=="BETWEEN" and "Find the next glow" or "Open my clue",action="StartMission",fields={missionId=m.missionId}}
end
function UIModel.answer(state,optionId)
 local m=state and state.mission;if not m or m.status~="ACTIVE" then return nil end
 for _,option in ipairs(m.options or {}) do if option.id==optionId then
  return {action="SubmitAnswer",fields={missionId=m.missionId,payload={activityId=m.activityId,contentVersion=m.contentVersion,answer=optionId}}}
 end end
 return nil
end
function UIModel.target(m)
 if not m then return nil end
 local index=m.checkpointIndex or 1
 for _,quest in ipairs(UIModel.quests) do if quest.id==m.missionId then return index==1 and quest.station or (quest.id.."-checkpoint-"..index) end end
 return nil
end
function UIModel.layout(width,height,touch)
 width=math.max(width,1);height=math.max(height,1)
 local narrow=width<620;local landscape=width>height and height<560
 local mobile=touch==true or math.min(width,height)<520
 local panelWidth=math.min(mobile and 392 or 380,width-24)
 if landscape then panelWidth=math.min(mobile and 374 or 360,math.floor(width*.49)) end
 local ratio=landscape and (mobile and .82 or .73) or (mobile and .72 or .59)
 local panelHeight=math.max(180,math.min(mobile and 590 or 520,math.floor(height*ratio)))
 local top=landscape and 6 or math.floor(height*(mobile and .10 or .14))
 return {
  width=panelWidth,height=panelHeight,top=top,center=narrow and not landscape,landscape=landscape,mobile=mobile,
  trackerWidth=math.min(mobile and 316 or 300,landscape and width-panelWidth-36 or width-24),
  trackerHeight=mobile and 170 or 158,navHeight=mobile and 52 or 42,openHeight=mobile and 44 or 36,
  closeSize=mobile and 50 or 44,primaryHeight=mobile and 54 or 46,contentButtonHeight=mobile and 54 or 48,
  contentTextSize=mobile and 18 or 17,
 }
end
function UIModel.saveText(status)
 if status=="STUDIO_SESSION_ONLY" then return "Studio practice: saves last only while this test server stays open." end
 if status=="SAVED" or status=="LOADED" then return "Progress saved." end
 if status=="SAVING" then return "Saving progress..." end
 return "Progress is not confirmed saved. Please keep this session open."
end
return UIModel
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
