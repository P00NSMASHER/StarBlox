--!strict

local SchoolDayTransitionJournal = require(script.Parent.Parent.src.server.SchoolDayTransitionJournal)

return function()
	describe("SchoolDayTransitionJournal", function()
		it("retains transitions in ascending sequence order", function()
			local journal = SchoolDayTransitionJournal.new(3)
			expect(journal:append({sequence = 1})).to.equal(true)
			expect(journal:append({sequence = 2})).to.equal(true)
			local replay = journal:readAfter(0)
			expect(#replay.events).to.equal(2)
			expect(replay.events[1].sequence).to.equal(1)
			expect(replay.events[2].sequence).to.equal(2)
			expect(replay.gapDetected).to.equal(false)
		end)

		it("rejects duplicate and stale transition sequences", function()
			local journal = SchoolDayTransitionJournal.new(3)
			expect(journal:append({sequence = 2})).to.equal(true)
			expect(journal:append({sequence = 2})).to.equal(false)
			expect(journal:append({sequence = 1})).to.equal(false)
			local latest = journal:getLatest()
			assert(latest ~= nil)
			expect(latest.sequence).to.equal(2)
		end)

		it("bounds memory and reports a replay gap", function()
			local journal = SchoolDayTransitionJournal.new(2)
			journal:append({sequence = 1})
			journal:append({sequence = 2})
			journal:append({sequence = 3})
			local replay = journal:readAfter(0)
			expect(#replay.events).to.equal(2)
			expect(replay.events[1].sequence).to.equal(2)
			expect(replay.oldestSequence).to.equal(2)
			expect(replay.latestSequence).to.equal(3)
			expect(replay.gapDetected).to.equal(true)
		end)

		it("returns only transitions newer than the client cursor", function()
			local journal = SchoolDayTransitionJournal.new(3)
			journal:append({sequence = 1})
			journal:append({sequence = 2})
			journal:append({sequence = 3})
			local replay = journal:readAfter(2)
			expect(#replay.events).to.equal(1)
			expect(replay.events[1].sequence).to.equal(3)
			expect(replay.gapDetected).to.equal(false)
		end)
	end)
end
