local BY_ID = {}
for _, pool in QUESTIONS_BY_STATION do
	for _, question in pool do
		BY_ID[question.Id] = question
	end
end

local function normalizedCursor(value: any): number
	local parsed = tonumber(value) or 0
	if parsed ~= parsed then return 0 end
	return math.max(0, math.floor(parsed))
end

function CoreQuestionBank.Select(stationId: string, cursor: any, targetDifficulty: number?)
	local pool = QUESTIONS_BY_STATION[stationId]
	if pool == nil or #pool == 0 then return nil end
	local clean = normalizedCursor(cursor)
	local materialCount = MATERIAL_COUNT_BY_STATION[stationId] or 0
	if clean < materialCount then return pool[clean + 1] end
	local fallbackCount = #pool - materialCount
	if fallbackCount <= 0 then return pool[(clean % #pool) + 1] end
	if type(targetDifficulty) == "number" then
		local preferred = {}
		for index = materialCount + 1, #pool do
			local candidate = pool[index]
			if candidate.Difficulty == targetDifficulty then table.insert(preferred, candidate) end
		end
		if #preferred > 0 then
			local preferredOffset = (clean - materialCount) % #preferred
			return preferred[preferredOffset + 1]
		end
	end
	local fallbackOffset = (clean - materialCount) % fallbackCount
	return pool[materialCount + fallbackOffset + 1]
end

function CoreQuestionBank.FindSupportQuestion(stationId: string, currentQuestionId: string, maxDifficulty: number?)
	local pool = QUESTIONS_BY_STATION[stationId]
	local current = BY_ID[currentQuestionId]
	if pool == nil or current == nil then return nil end
	local ceiling = tonumber(maxDifficulty) or 2
	for _, candidate in pool do
		if candidate.Id ~= currentQuestionId
			and candidate.Skill == current.Skill
			and (tonumber(candidate.Difficulty) or 3) <= ceiling
		then
			return candidate
		end
	end
	for _, candidate in pool do
		if candidate.Id ~= currentQuestionId
			and candidate.Domain == current.Domain
			and candidate.Subject == current.Subject
			and (tonumber(candidate.Difficulty) or 3) <= ceiling
		then
			return candidate
		end
	end
	return nil
end

function CoreQuestionBank.GetById(questionId: string)
	return BY_ID[questionId]
end

function CoreQuestionBank.Grade(questionId: any, choice: any): boolean
	if type(questionId) ~= "string" or type(choice) ~= "string" then return false end
	local question = BY_ID[questionId]
	return question ~= nil and string.lower(choice) == string.lower(question.Answer)
end

function CoreQuestionBank.CountForStation(stationId: string): number
	local pool = QUESTIONS_BY_STATION[stationId]
	return if pool == nil then 0 else #pool
end

CoreQuestionBank.Source = SOURCE
CoreQuestionBank.MaterialCountByStation = MATERIAL_COUNT_BY_STATION
CoreQuestionBank.QuestionsByStation = QUESTIONS_BY_STATION

return table.freeze(CoreQuestionBank)
