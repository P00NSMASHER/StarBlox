{
  "name": "starblox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest run",
    "certification:gate": "vitest run src/generation/solutionFirstLevel.test.js src/daily/dailyBundle.test.js src/daily/dailyReleaseControl.test.js src/robloxRuntime/runtimeArtifactBoundary.test.js",
    "balance:gate": "node scripts/balance-gate.mjs",
    "questions:generate": "node scripts/generate-questions-offline.mjs",
    "recalibrate:telemetry": "node scripts/recalibrate-telemetry.mjs",
    "roblox:catalog": "node scripts/catalog-roblox.mjs",
    "roblox:catalog:reader:test": "cargo test --manifest-path tools/roblox_catalog_reader/Cargo.toml --quiet",
    "studio:factory": "node scripts/ai-development-factory.mjs",
    "studio:bridge": "node scripts/studio-bridge.mjs",
    "roblox:migrate": "node scripts/migrate-roblox.mjs",
    "roblox:migration:exporter:test": "cargo test --manifest-path tools/roblox_migration_exporter/Cargo.toml --quiet",
    "content:expand": "node scripts/expand-content.mjs",
    "roblox:source:preflight": "node scripts/roblox-source-preflight.mjs",
    "roblox:ingest": "node scripts/ingest-roblox-source.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^25.0.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
