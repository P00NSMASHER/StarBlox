{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starblox://schemas/neutral-progression-rule-v1",
  "title": "StarBlox Neutral Progression Rule v1",
  "description": "Closed read-only rule contract for Step 10 progression shadow evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "targetType",
    "targetId",
    "criteria",
    "sourceRef"
  ],
  "properties": {
    "schemaVersion": {
      "const": "starblox-neutral-progression-rule-v1"
    },
    "targetType": {
      "type": "string",
      "enum": [
        "residential",
        "vehicle",
        "town"
      ]
    },
    "targetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "criteria": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "gte"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "enum": [
              "questsCompleted",
              "stars",
              "starWorth",
              "masteredCount"
            ]
          },
          "gte": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    }
  }
}
