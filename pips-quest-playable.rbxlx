  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="7">
      <Properties>
        <string name="Name">Core</string>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")

local WorldBuilder = require(script.Parent.WorldBuilder)

local world = WorldBuilder.build()
workspace:SetAttribute("PipsQuestCoreReady", true)

local function moveToQuestSpawn(character)
    local root = character:WaitForChild("HumanoidRootPart", 10)
    if not root then
        return
    end
    character:PivotTo(world.spawn.CFrame + Vector3.new(0, 4, 0))
end

local function bindPlayer(player)
    player.CharacterAdded:Connect(moveToQuestSpawn)
    if player.Character then
        task.defer(moveToQuestSpawn, player.Character)
    end
end

Players.PlayerAdded:Connect(bindPlayer)
for _, player in ipairs(Players:GetPlayers()) do
    bindPlayer(player)
end

print("[PIPS][CORE_READY] Pip's Quest core world generated")
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="8">
      <Properties>
        <string name="Name">QuestFlow</string>
        <string name="Source">local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)

local shared = ReplicatedStorage:WaitForChild(&quot;PipsQuestShared&quot;)
local EducationEngine = require(shared:WaitForChild(&quot;EducationEngine&quot;))
local QuestionBank = require(shared:WaitForChild(&quot;QuestionBank&quot;))

local world = workspace:WaitForChild(&quot;PipsQuestWorld&quot;)
local gate = world:WaitForChild(&quot;LearningGate&quot;)
local star = world:WaitForChild(&quot;QuestStar&quot;)
local trigger = world:WaitForChild(&quot;QuestionTrigger&quot;)
local finish = world:WaitForChild(&quot;FinishPad&quot;)
local replay = world:WaitForChild(&quot;ReplayPad&quot;)
local lanterns = world:WaitForChild(&quot;LearningLanterns&quot;)
local chest = world:WaitForChild(&quot;RewardChest&quot;)
local chestBase = chest:WaitForChild(&quot;Base&quot;)
local chestLid = chest:WaitForChild(&quot;Lid&quot;)
local chestLock = chest:WaitForChild(&quot;Lock&quot;)
local chestGlow = chest:WaitForChild(&quot;GlowCore&quot;)
local chestPrompt = chestBase:WaitForChild(&quot;OpenPrompt&quot;)
local chestClosedCFrame = chestLid.CFrame
local chestLockClosedCFrame = chestLock.CFrame
local chestHingeCFrame = chestClosedCFrame * CFrame.new(0, 0, 1.8)
local chestOpenCFrame = chestHingeCFrame
    * CFrame.Angles(math.rad(108), 0, 0)
    * CFrame.new(0, 0, -1.8)
local gateClosedCFrame = gate.CFrame
local gateOpenCFrame = gateClosedCFrame * CFrame.new(0, 7.5, 0)
local starOriginalSize = star.Size

local remote = ReplicatedStorage:FindFirstChild(&quot;PipsQuestEvent&quot;)
if not remote then
    remote = Instance.new(&quot;RemoteEvent&quot;)
    remote.Name = &quot;PipsQuestEvent&quot;
    remote.Parent = ReplicatedStorage
end

local bankOk, bankError = EducationEngine.validateBank(QuestionBank)
assert(bankOk, bankError)

local stateByUser = {}
local function playerFromHit(hit)
    if not hit then
        return nil
    end
    local character = hit:FindFirstAncestorOfClass(&quot;Model&quot;)
    if not character then
        return nil
    end
    return Players:GetPlayerFromCharacter(character)
end

local function getState(player)
    local state = stateByUser[player.UserId]
    if not state then
        state = {
            history = EducationEngine.newHistory(),
            collected = false,
            question = nil,
            misses = 0,
            solved = false,
            finished = false,
            finishReached = false,
            transitioning = false,
            rewardCount = 0,
            independentCorrect = 0,
            supportedResolved = 0,
            touchTimes = {},
        }
        stateByUser[player.UserId] = state
    end
    return state
end
local function recentlyTouched(state, key, delaySeconds)
    local now = os.clock()
    local last = state.touchTimes[key] or 0
    if now - last &lt; (delaySeconds or 0.75) then
        return true
    end
    state.touchTimes[key] = now
    return false
end

local function setGateOpen(isOpen)
    gate.CanCollide = not isOpen
    local target = isOpen and gateOpenCFrame or gateClosedCFrame
    local transparency = isOpen and 0.96 or 0.42
    local color = isOpen and Color3.fromRGB(133, 233, 184) or Color3.fromRGB(104, 211, 205)

    if not isOpen then
        gate.CFrame = gateClosedCFrame
        gate.Transparency = 0.42
        gate.Color = color
        return
    end

    TweenService:Create(
        gate,
        TweenInfo.new(0.78, Enum.EasingStyle.Back, Enum.EasingDirection.InOut),
        { CFrame = target, Transparency = transparency, Color = color }
    ):Play()

    local sound = Instance.new(&quot;Sound&quot;)
    sound.SoundId = &quot;rbxasset://sounds/electronicpingshort.wav&quot;
    sound.Volume = 0.55
    sound.PlaybackSpeed = 0.78
    sound.Parent = gate
    sound:Play()
    task.delay(2, function()
        if sound.Parent then sound:Destroy() end
    end)
end

local function setWorldProgress(count)
    count = math.clamp(tonumber(count) or 0, 0, EducationEngine.QUEST_LENGTH)
    for index = 1, EducationEngine.QUEST_LENGTH do
        local lantern = lanterns:FindFirstChild(&quot;Lantern&quot; .. index)
        if lantern then
            local lit = index &lt;= count
            local wasLit = lantern:GetAttribute(&quot;Lit&quot;) == true
            lantern:SetAttribute(&quot;Lit&quot;, lit)
            lantern.Material = lit and Enum.Material.Neon or Enum.Material.SmoothPlastic
            local targetColor = lit and Color3.fromRGB(255, 218, 92) or Color3.fromRGB(76, 82, 82)

            TweenService:Create(
                lantern,
                TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                {
                    Color = targetColor,
                    Transparency = lit and 0 or 0.12,
                    Size = lit and Vector3.new(1.25, 1.25, 1.25) or Vector3.new(1.05, 1.05, 1.05),
                }
            ):Play()

            local light = lantern:FindFirstChildOfClass(&quot;PointLight&quot;)
            if not light then
                light = Instance.new(&quot;PointLight&quot;)
                light.Range = 9
                light.Color = Color3.fromRGB(255, 220, 92)
                light.Parent = lantern
            end
            light.Enabled = lit
            light.Brightness = lit and 1.6 or 0

            if lit and not wasLit then
                local emitter = Instance.new(&quot;ParticleEmitter&quot;)
                emitter.Texture = &quot;rbxasset://textures/particles/sparkles_main.dds&quot;
                emitter.Rate = 0
                emitter.Lifetime = NumberRange.new(0.45, 0.8)
                emitter.Speed = NumberRange.new(1.5, 3)
                emitter.SpreadAngle = Vector2.new(360, 360)
                emitter.LightEmission = 0.75
                emitter.Parent = lantern
                emitter:Emit(22)

                local ping = Instance.new(&quot;Sound&quot;)
                ping.SoundId = &quot;rbxasset://sounds/electronicpingshort.wav&quot;
                ping.Volume = 0.34
                ping.PlaybackSpeed = 0.9 + index * 0.06
                ping.Parent = lantern
                ping:Play()

                task.delay(1.2, function()
                    if emitter.Parent then emitter:Destroy() end
                    if ping.Parent then ping:Destroy() end
                end)
            end
        end
    end
end

local function closeChest()
    chestLid.CFrame = chestClosedCFrame
    chestLock.CFrame = chestLockClosedCFrame
    chestLock.Transparency = 0
    chestGlow.Transparency = 1
    chestPrompt.Enabled = false

    local light = chestGlow:FindFirstChild(&quot;RewardLight&quot;) or chestGlow:FindFirstChildOfClass(&quot;PointLight&quot;)
    if light then
        light.Enabled = false
        light.Brightness = 0
    end

    for _, name in ipairs({ &quot;RewardBeam&quot;, &quot;RewardStar&quot;, &quot;RewardRing&quot; }) do
        local old = chest:FindFirstChild(name)
        if old then old:Destroy() end
    end
end

local function openChest()
    chestPrompt.Enabled = false

    local openSound = Instance.new(&quot;Sound&quot;)
    openSound.SoundId = &quot;rbxasset://sounds/electronicpingshort.wav&quot;
    openSound.Volume = 0.5
    openSound.PlaybackSpeed = 0.58
    openSound.Parent = chestBase
    openSound:Play()

    TweenService:Create(
        chestLock,
        TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Transparency = 1, CFrame = chestLockClosedCFrame * CFrame.new(0, -0.7, -0.35) }
    ):Play()

    task.delay(0.16, function()
        TweenService:Create(
            chestLid,
            TweenInfo.new(0.72, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            { CFrame = chestOpenCFrame }
        ):Play()
    end)

    local light = chestGlow:FindFirstChild(&quot;RewardLight&quot;) or chestGlow:FindFirstChildOfClass(&quot;PointLight&quot;)
    if not light then
        light = Instance.new(&quot;PointLight&quot;)
        light.Name = &quot;RewardLight&quot;
        light.Color = Color3.fromRGB(255, 231, 103)
        light.Range = 20
        light.Parent = chestGlow
    end
    light.Enabled = true

    task.delay(0.36, function()
        chestGlow.Transparency = 0.08
        TweenService:Create(light, TweenInfo.new(0.28), { Brightness = 7 }):Play()
    end)

    task.delay(0.5, function()
        local rewardSound = Instance.new(&quot;Sound&quot;)
        rewardSound.SoundId = &quot;rbxasset://sounds/electronicpingshort.wav&quot;
        rewardSound.Volume = 0.9
        rewardSound.PlaybackSpeed = 1.12
        rewardSound.Parent = chestGlow
        rewardSound:Play()

        local sparkle = Instance.new(&quot;ParticleEmitter&quot;)
        sparkle.Name = &quot;ChestBurst&quot;
        sparkle.Texture = &quot;rbxasset://textures/particles/sparkles_main.dds&quot;
        sparkle.Rate = 0
        sparkle.Lifetime = NumberRange.new(0.8, 1.55)
        sparkle.Speed = NumberRange.new(7, 13)
        sparkle.SpreadAngle = Vector2.new(360, 360)
        sparkle.Rotation = NumberRange.new(0, 360)
        sparkle.RotSpeed = NumberRange.new(-180, 180)
        sparkle.LightEmission = 0.9
        sparkle.Parent = chestGlow
        sparkle:Emit(140)

        local ring = Instance.new(&quot;Part&quot;)
        ring.Name = &quot;RewardRing&quot;
        ring.Shape = Enum.PartType.Cylinder
        ring.Anchored = true
        ring.CanCollide = false
        ring.CanTouch = false
        ring.CanQuery = false
        ring.Material = Enum.Material.Neon
        ring.Color = Color3.fromRGB(255, 224, 90)
        ring.Transparency = 0.18
        ring.Size = Vector3.new(0.18, 1.8, 1.8)
        ring.CFrame = CFrame.new(chestGlow.Position + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90))
        ring.Parent = chest
        TweenService:Create(ring, TweenInfo.new(0.75, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = Vector3.new(0.18, 8.5, 8.5),
            Transparency = 1,
        }):Play()

        local reward = Instance.new(&quot;Part&quot;)
        reward.Name = &quot;RewardStar&quot;
        reward.Shape = Enum.PartType.Ball
        reward.Size = Vector3.new(0.9, 0.9, 0.9)
        reward.Anchored = true
        reward.CanCollide = false
        reward.CanTouch = false
        reward.CanQuery = false
        reward.Material = Enum.Material.Neon
        reward.Color = Color3.fromRGB(255, 221, 74)
        reward.CFrame = CFrame.new(chestGlow.Position + Vector3.new(0, 0.45, 0))
        reward.Parent = chest

        local rewardLight = Instance.new(&quot;PointLight&quot;)
        rewardLight.Range = 13
        rewardLight.Brightness = 3.2
        rewardLight.Color = reward.Color
        rewardLight.Parent = reward

        local gui = Instance.new(&quot;BillboardGui&quot;)
        gui.Name = &quot;StarGlyph&quot;
        gui.Size = UDim2.fromOffset(84, 84)
        gui.AlwaysOnTop = true
        gui.Parent = reward
        local glyph = Instance.new(&quot;TextLabel&quot;)
        glyph.Size = UDim2.fromScale(1, 1)
        glyph.BackgroundTransparency = 1
        glyph.Font = Enum.Font.GothamBlack
        glyph.Text = &quot;★&quot;
        glyph.TextColor3 = Color3.fromRGB(255, 241, 142)
        glyph.TextStrokeColor3 = Color3.fromRGB(112, 77, 19)
        glyph.TextStrokeTransparency = 0.25
        glyph.TextScaled = true
        glyph.Parent = gui

        TweenService:Create(
            reward,
            TweenInfo.new(1.0, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {
                CFrame = CFrame.new(chestGlow.Position + Vector3.new(0, 5.4, 0)),
                Size = Vector3.new(1.65, 1.65, 1.65),
            }
        ):Play()

        task.delay(0.95, function()
            if reward.Parent then
                TweenService:Create(reward, TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
                    CFrame = CFrame.new(chestGlow.Position + Vector3.new(0, 5.9, 0)),
                }):Play()
            end
        end)

        task.delay(2.6, function()
            if ring.Parent then ring:Destroy() end
            if sparkle.Parent then sparkle:Destroy() end
            if rewardSound.Parent then rewardSound:Destroy() end
            if openSound.Parent then openSound:Destroy() end
            TweenService:Create(light, TweenInfo.new(0.8), { Brightness = 1.4 }):Play()
        end)
    end)
end

local function setAnswerLabels(question)
    local optionCount = question and #question.options or 0
    for index = 1, 3 do
        local pad = world:FindFirstChild(&quot;Answer&quot; .. index)
        if pad then
            local active = index &lt;= optionCount
            pad.Transparency = active and 0 or 1
            pad.CanTouch = active
            pad.CanCollide = active
            local gui = pad:FindFirstChild(&quot;Label&quot;)
            if gui then
                gui.Enabled = active
            end
            local label = gui and gui:FindFirstChild(&quot;AnswerText&quot;)
            if label then
                label.Text = active and question.options[index] or &quot;&quot;
            end
        end
    end
end

local function setGateLabel(text)
    local gui = gate:FindFirstChild(&quot;Label&quot;)
    local label = gui and gui:FindFirstChild(&quot;Text&quot;)
    if label then
        label.Text = text
    end
end

local function chooseQuestion(state)
    local seed = math.floor(os.clock() * 100000) % 2147483647
    local rng = Random.new(seed)
    local question = EducationEngine.pickNextQuestion(QuestionBank, state.history, rng)
    state.question = question
    state.misses = 0
    EducationEngine.markShown(state.history, question)
    setAnswerLabels(question)
    setGateLabel(
        (&quot;LANTERN %d/%d&quot;):format(
            state.history.resolvedCount + 1,
            EducationEngine.QUEST_LENGTH
        )
    )
    return question
end
local function presentQuestion(player, state)
    local question = state.question or chooseQuestion(state)
    remote:FireClient(
        player,
        &quot;question&quot;,
        EducationEngine.clientView(question, state.history.resolvedCount + 1)
    )
    print(
        &quot;[PIPS][QUESTION]&quot;,
        player.Name,
        question.id,
        state.history.resolvedCount + 1,
        question.tier,
        question.skill
    )
end

local function scheduleNextQuestion(player, state, delaySeconds)
    state.transitioning = true
    task.delay(delaySeconds or 1.1, function()
        if not player.Parent then
            return
        end
        local current = stateByUser[player.UserId]
        if current ~= state or state.solved or state.finished then
            return
        end
        state.transitioning = false
        chooseQuestion(state)
        presentQuestion(player, state)
    end)
end
local function completeResolvedQuestion(player, state, question, supported)
    EducationEngine.markResolved(state.history)
    setWorldProgress(state.history.resolvedCount)
    if supported then
        state.supportedResolved += 1
        EducationEngine.queueComeback(state.history, question, 2)
    end

    state.question = nil
    state.misses = 0

    if state.history.resolvedCount &gt;= EducationEngine.QUEST_LENGTH then
        state.solved = true
        state.transitioning = false
        setGateOpen(true)
        setAnswerLabels(nil)
        setGateLabel(&quot;PATH OPEN&quot;)
        remote:FireClient(player, &quot;quest_ready&quot;, {
            message = &quot;Gate open — keep going!&quot;,
            questionProgress = EducationEngine.QUEST_LENGTH,
            questionTotal = EducationEngine.QUEST_LENGTH,
        })
        print(
            &quot;[PIPS][QUEST_GATE_CLEARED]&quot;,
            player.Name,
            state.independentCorrect,
            state.supportedResolved
        )
        return
    end

    scheduleNextQuestion(player, state, supported and 1.05 or 0.72)
end
local function resetPlayer(player, teleport)
    local state = getState(player)
    EducationEngine.beginQuest(state.history)
    state.collected = false
    state.question = nil
    state.misses = 0
    state.solved = false
    state.finished = false
    state.finishReached = false
    state.transitioning = false
    state.independentCorrect = 0
    state.supportedResolved = 0
    state.touchTimes = {}

    setGateOpen(false)
    setAnswerLabels(nil)
    setWorldProgress(0)
    closeChest()
    setGateLabel(&quot;LIGHT THE FIVE LANTERNS&quot;)
    star.Size = starOriginalSize
    star.Transparency = 0
    star.CanTouch = true
    local starFx = star:FindFirstChild(&quot;QuestSparkles&quot;)
    if starFx then starFx.Enabled = true end

    remote:FireClient(player, &quot;reset&quot;, {
        message = &quot;Find the Quest Star&quot;,
        rewardCount = state.rewardCount,
        questionProgress = 0,
        questionTotal = EducationEngine.QUEST_LENGTH,
    })

    if teleport and player.Character then
        local spawn = world:FindFirstChild(&quot;QuestSpawn&quot;)
        if spawn then
            player.Character:PivotTo(spawn.CFrame + Vector3.new(0, 4, 0))
        end
    end
end
star.Touched:Connect(function(hit)
    local player = playerFromHit(hit)
    if not player then
        return
    end

    local state = getState(player)
    if state.collected or recentlyTouched(state, &quot;star&quot;) then
        return
    end

    state.collected = true
    star.CanTouch = false
    local starFx = star:FindFirstChild(&quot;QuestSparkles&quot;)
    if starFx then
        starFx:Emit(45)
        starFx.Enabled = false
    end
    TweenService:Create(
        star,
        TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.In),
        { Transparency = 1, Size = Vector3.new(0.22, 0.22, 0.22) }
    ):Play()
    remote:FireClient(player, &quot;status&quot;, {
        message = &quot;Star found — jump the log!&quot;,
        stage = &quot;star&quot;,
        questionProgress = 0,
        questionTotal = EducationEngine.QUEST_LENGTH,
    })
    print(&quot;[PIPS][STAR_COLLECTED]&quot;, player.Name)
end)

trigger.Touched:Connect(function(hit)
    local player = playerFromHit(hit)
    if not player then
        return
    end

    local state = getState(player)
    if recentlyTouched(state, &quot;question&quot;, 0.6) then
        return
    end

    if not state.collected then
        remote:FireClient(player, &quot;status&quot;, {
            message = &quot;Grab the glowing Quest Star first!&quot;,
            stage = &quot;need_star&quot;,
            questionProgress = state.history.resolvedCount,
            questionTotal = EducationEngine.QUEST_LENGTH,
        })
        return
    end

    if state.solved or state.transitioning then
        return
    end

    presentQuestion(player, state)
end)

local function handleAnswer(player, index, source)
    index = tonumber(index)
    if not index or index % 1 ~= 0 or index &lt; 1 then
        return
    end

    local state = getState(player)
    if state.transitioning or state.solved or not state.question then
        return
    end
    if index &gt; #state.question.options then
        return
    end

    local touchKey = (source or &quot;answer&quot;) .. tostring(index)
    if recentlyTouched(state, touchKey, 0.3) then
        return
    end
    if EducationEngine.isCorrect(state.question, index) then
        local question = state.question
        local independent = state.misses == 0
        if independent then
            state.independentCorrect += 1
        end

        remote:FireClient(player, &quot;feedback&quot;, {
            correct = true,
            message = EducationEngine.getExplanation(question),
            questionProgress = state.history.resolvedCount + 1,
            questionTotal = EducationEngine.QUEST_LENGTH,
            independent = independent,
        })
        print(
            &quot;[PIPS][ANSWER_CORRECT]&quot;,
            player.Name,
            question.id,
            index,
            source or &quot;world&quot;,
            independent and &quot;independent&quot; or &quot;supported&quot;
        )
        completeResolvedQuestion(player, state, question, not independent)
        return
    end

    state.misses += 1
    local question = state.question
    local message, supportKind = EducationEngine.getWrongFeedback(question, index, state.misses)
    remote:FireClient(player, &quot;feedback&quot;, {
        correct = false,
        message = message,
        attempt = state.misses,
        supportKind = supportKind,
        questionProgress = state.history.resolvedCount,
        questionTotal = EducationEngine.QUEST_LENGTH,
        modeled = state.misses &gt;= 3,
    })

    print(
        &quot;[PIPS][ANSWER_WRONG]&quot;,
        player.Name,
        question.id,
        index,
        state.misses,
        supportKind,
        source or &quot;world&quot;
    )

    if state.misses &gt;= 3 then
        completeResolvedQuestion(player, state, question, true)
    end
end

for index = 1, 3 do
    local answerIndex = index
    local pad = world:WaitForChild(&quot;Answer&quot; .. answerIndex)
    pad.Touched:Connect(function(hit)
        local player = playerFromHit(hit)
        if not player then
            return
        end
        handleAnswer(player, answerIndex, &quot;world&quot;)
    end)
end

remote.OnServerEvent:Connect(function(player, kind, value)
    if kind == &quot;answer&quot; then
        handleAnswer(player, value, &quot;mobile&quot;)
    end
end)

finish.Touched:Connect(function(hit)
    local player = playerFromHit(hit)
    if not player then
        return
    end

    local state = getState(player)
    if state.finished or recentlyTouched(state, &quot;finish&quot;) then
        return
    end

    if not state.solved then
        remote:FireClient(player, &quot;status&quot;, {
            message = &quot;Light all five lanterns first&quot;,
            questionProgress = state.history.resolvedCount,
            questionTotal = EducationEngine.QUEST_LENGTH,
        })
        return
    end

    if not state.finishReached then
        state.finishReached = true
        chestPrompt.Enabled = true
        remote:FireClient(player, &quot;status&quot;, {
            message = &quot;Chest unlocked — open it!&quot;,
            questionProgress = EducationEngine.QUEST_LENGTH,
            questionTotal = EducationEngine.QUEST_LENGTH,
        })
        print(&quot;[PIPS][CHEST_UNLOCKED]&quot;, player.Name)
    end
end)

chestPrompt.Triggered:Connect(function(player)
    local state = getState(player)
    if state.finished or not state.solved or not state.finishReached then
        return
    end

    state.finished = true
    state.rewardCount += 1
    chestPrompt.Enabled = false
    openChest()

    task.delay(1.05, function()
        if not player.Parent then
            return
        end
        remote:FireClient(player, &quot;reward&quot;, {
            message = &quot;Star Trail unlocked!&quot;,
            rewardCount = state.rewardCount,
            independentCorrect = state.independentCorrect,
            supportedResolved = state.supportedResolved,
            questionProgress = EducationEngine.QUEST_LENGTH,
            questionTotal = EducationEngine.QUEST_LENGTH,
        })
    end)

    print(
        &quot;[PIPS][QUEST_FINISHED]&quot;,
        player.Name,
        state.rewardCount,
        state.independentCorrect,
        state.supportedResolved
    )
end)

replay.Touched:Connect(function(hit)
    local player = playerFromHit(hit)
    if not player then
        return
    end

    local state = getState(player)
    if not state.finished or recentlyTouched(state, &quot;replay&quot;) then
        return
    end

    resetPlayer(player, true)
    print(&quot;[PIPS][REPLAY]&quot;, player.Name)
end)

Players.PlayerAdded:Connect(function(player)
    task.defer(function()
        resetPlayer(player, false)
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    stateByUser[player.UserId] = nil
end)

for _, player in ipairs(Players:GetPlayers()) do
    getState(player)
    task.defer(function()
        resetPlayer(player, false)
    end)
end

setGateOpen(false)
setAnswerLabels(nil)
workspace:SetAttribute(&quot;PipsQuestFlowReady&quot;, true)
print(&quot;[PIPS][FLOW_READY] Five-question adaptive learning gate initialized&quot;)
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="9">
      <Properties>
        <string name="Name">WorldBuilder</string>
        <string name="Source">local Workspace = game:GetService(&quot;Workspace&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)

local WorldBuilder = {}
local ROOT_NAME = &quot;PipsQuestWorld&quot;

local function makePart(parent, name, size, cframe, color, material)
    local part = Instance.new(&quot;Part&quot;)
    part.Name = name
    part.Size = size
    part.CFrame = cframe
    part.Anchored = true
    part.CanCollide = true
    part.Color = color
    part.Material = material or Enum.Material.SmoothPlastic
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = parent
    return part
end

local function addBillboard(part, text, width, height, maxTextSize, maxDistance)
    local gui = Instance.new(&quot;BillboardGui&quot;)
    gui.Name = &quot;Label&quot;
    gui.Size = UDim2.fromOffset(width or 170, height or 42)
    gui.StudsOffset = Vector3.new(0, 2.8, 0)
    gui.AlwaysOnTop = false
    gui.MaxDistance = maxDistance or 28
    gui.LightInfluence = 0
    gui.Parent = part

    local label = Instance.new(&quot;TextLabel&quot;)
    label.Name = &quot;Text&quot;
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 0.1
    label.BackgroundColor3 = Color3.fromRGB(250, 252, 248)
    label.TextColor3 = Color3.fromRGB(30, 44, 39)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.TextWrapped = true
    label.Text = text
    label.Parent = gui

    local textLimit = Instance.new(&quot;UITextSizeConstraint&quot;)
    textLimit.MinTextSize = 10
    textLimit.MaxTextSize = maxTextSize or 16
    textLimit.Parent = label

    local corner = Instance.new(&quot;UICorner&quot;)
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = label
    return label
end

local function configureLighting()
    Lighting.Brightness = 2.6
    Lighting.ClockTime = 15.4
    Lighting.GlobalShadows = true
    Lighting.Ambient = Color3.fromRGB(116, 134, 125)
    Lighting.OutdoorAmbient = Color3.fromRGB(150, 165, 153)

    local oldColor = Lighting:FindFirstChild(&quot;PipsQuestColor&quot;)
    if oldColor then oldColor:Destroy() end
    local color = Instance.new(&quot;ColorCorrectionEffect&quot;)
    color.Name = &quot;PipsQuestColor&quot;
    color.Brightness = 0.025
    color.Contrast = 0.07
    color.Saturation = 0.08
    color.TintColor = Color3.fromRGB(255, 249, 236)
    color.Parent = Lighting

    local oldBloom = Lighting:FindFirstChild(&quot;PipsQuestBloom&quot;)
    if oldBloom then oldBloom:Destroy() end
    local bloom = Instance.new(&quot;BloomEffect&quot;)
    bloom.Name = &quot;PipsQuestBloom&quot;
    bloom.Intensity = 0.22
    bloom.Size = 18
    bloom.Threshold = 1.25
    bloom.Parent = Lighting
end

local function makeAnswerPad(parent, index, z)
    local colors = {
        Color3.fromRGB(103, 162, 221),
        Color3.fromRGB(210, 123, 164),
        Color3.fromRGB(221, 180, 83),
    }
    local pad = makePart(
        parent,
        &quot;Answer&quot; .. index,
        Vector3.new(4.8, 0.45, 3.2),
        CFrame.new(-7.15, 0.78, z),
        colors[index],
        Enum.Material.Neon
    )
    pad.CanCollide = false
    pad.Transparency = 1
    pad:SetAttribute(&quot;AnswerIndex&quot;, index)
    local label = addBillboard(pad, &quot;Answer &quot; .. index, 150, 44, 13, 22)
    label.Name = &quot;AnswerText&quot;
    label.Parent.Enabled = false
    return pad
end

local function makeTree(parent, index, x, z, scale)
    local trunk = makePart(parent, &quot;TreeTrunk&quot; .. index, Vector3.new(1.3, 5.6 * scale, 1.3), CFrame.new(x, 2.8 * scale, z), Color3.fromRGB(102, 72, 49), Enum.Material.Wood)
    trunk.CanCollide = false
    local crown = makePart(parent, &quot;TreeCrown&quot; .. index, Vector3.new(4.2 * scale, 4.2 * scale, 4.2 * scale), CFrame.new(x, 6.2 * scale, z), Color3.fromRGB(68, 129, 82), Enum.Material.Grass)
    crown.Shape = Enum.PartType.Ball
    crown.CanCollide = false
end

local function makePathLantern(parent, index, x, z)
    local post = makePart(parent, &quot;PathPost&quot; .. index, Vector3.new(0.45, 2.6, 0.45), CFrame.new(x, 1.3, z), Color3.fromRGB(91, 65, 46), Enum.Material.Wood)
    post.CanCollide = false
    local lamp = makePart(parent, &quot;PathLamp&quot; .. index, Vector3.new(0.8, 0.8, 0.8), CFrame.new(x, 2.95, z), Color3.fromRGB(255, 211, 116), Enum.Material.Neon)
    lamp.Shape = Enum.PartType.Ball
    lamp.CanCollide = false
    local light = Instance.new(&quot;PointLight&quot;)
    light.Range = 7
    light.Brightness = 0.7
    light.Color = lamp.Color
    light.Parent = lamp
end

function WorldBuilder.build()
    configureLighting()

    local old = Workspace:FindFirstChild(ROOT_NAME)
    if old then old:Destroy() end

    local root = Instance.new(&quot;Model&quot;)
    root.Name = ROOT_NAME
    root.Parent = Workspace

    makePart(root, &quot;Ground&quot;, Vector3.new(23, 1, 112), CFrame.new(0, 0, 47), Color3.fromRGB(72, 137, 85), Enum.Material.Grass)

    local path = makePart(root, &quot;QuestPath&quot;, Vector3.new(7.4, 0.16, 108), CFrame.new(0, 0.58, 47), Color3.fromRGB(192, 170, 126), Enum.Material.Ground)
    path.CanCollide = false

    makePart(root, &quot;LeftBoundary&quot;, Vector3.new(1.1, 3.4, 112), CFrame.new(-11.5, 1.7, 47), Color3.fromRGB(55, 91, 68), Enum.Material.Grass)
    makePart(root, &quot;RightBoundary&quot;, Vector3.new(1.1, 3.4, 112), CFrame.new(11.5, 1.7, 47), Color3.fromRGB(55, 91, 68), Enum.Material.Grass)

    local scenery = Instance.new(&quot;Folder&quot;)
    scenery.Name = &quot;Scenery&quot;
    scenery.Parent = root

    local treeIndex = 0
    for z = 8, 96, 11 do
        treeIndex += 1
        makeTree(scenery, treeIndex, -14.2, z, 0.85 + ((treeIndex % 3) * 0.08))
        treeIndex += 1
        makeTree(scenery, treeIndex, 14.2, z + 4, 0.82 + ((treeIndex % 4) * 0.06))
    end

    local fireflies = Instance.new(&quot;Folder&quot;)
    fireflies.Name = &quot;Fireflies&quot;
    fireflies.Parent = scenery
    for index = 1, 18 do
        local side = index % 2 == 0 and -1 or 1
        local z = 7 + index * 5.1
        local y = 1.5 + (index % 4) * 0.55
        local fly = makePart(fireflies, &quot;Firefly&quot; .. index, Vector3.new(0.24, 0.24, 0.24), CFrame.new(side * (5.2 + (index % 3)), y, z), Color3.fromRGB(255, 226, 118), Enum.Material.Neon)
        fly.Shape = Enum.PartType.Ball
        fly.CanCollide = false
        local light = Instance.new(&quot;PointLight&quot;)
        light.Range = 3.5
        light.Brightness = 0.35
        light.Color = fly.Color
        light.Parent = fly
    end

    local spawn = Instance.new(&quot;SpawnLocation&quot;)
    spawn.Name = &quot;QuestSpawn&quot;
    spawn.Size = Vector3.new(6, 0.6, 6)
    spawn.CFrame = CFrame.new(0, 0.9, 2) * CFrame.Angles(0, math.rad(180), 0)
    spawn.Anchored = true
    spawn.Neutral = true
    spawn.Material = Enum.Material.SmoothPlastic
    spawn.Color = Color3.fromRGB(152, 218, 190)
    spawn.Transparency = 0.15
    spawn.Parent = root

    makePart(root, &quot;SpawnPostL&quot;, Vector3.new(0.8, 6, 0.8), CFrame.new(-4.2, 3.1, 5), Color3.fromRGB(101, 70, 45), Enum.Material.WoodPlanks)
    makePart(root, &quot;SpawnPostR&quot;, Vector3.new(0.8, 6, 0.8), CFrame.new(4.2, 3.1, 5), Color3.fromRGB(101, 70, 45), Enum.Material.WoodPlanks)
    local arch = makePart(root, &quot;SpawnArch&quot;, Vector3.new(9, 0.9, 0.9), CFrame.new(0, 6.0, 5), Color3.fromRGB(101, 70, 45), Enum.Material.WoodPlanks)
    addBillboard(arch, &quot;PIP&apos;S QUEST&quot;, 170, 38, 15, 26)

    local pedestal = makePart(root, &quot;StarPedestal&quot;, Vector3.new(3.2, 0.65, 3.2), CFrame.new(0, 0.92, 18.5), Color3.fromRGB(123, 118, 104), Enum.Material.Rock)
    pedestal.CanCollide = false

    local star = makePart(root, &quot;QuestStar&quot;, Vector3.new(2.3, 2.3, 2.3), CFrame.new(0, 3.0, 18.5), Color3.fromRGB(255, 220, 82), Enum.Material.Neon)
    star.Shape = Enum.PartType.Ball
    star.CanCollide = false
    local starLight = Instance.new(&quot;PointLight&quot;)
    starLight.Name = &quot;QuestLight&quot;
    starLight.Range = 12
    starLight.Brightness = 2.2
    starLight.Color = star.Color
    starLight.Parent = star
    local starFx = Instance.new(&quot;ParticleEmitter&quot;)
    starFx.Name = &quot;QuestSparkles&quot;
    starFx.Texture = &quot;rbxasset://textures/particles/sparkles_main.dds&quot;
    starFx.Rate = 8
    starFx.Lifetime = NumberRange.new(0.7, 1.1)
    starFx.Speed = NumberRange.new(0.3, 0.8)
    starFx.SpreadAngle = Vector2.new(360, 360)
    starFx.LightEmission = 0.8
    starFx.Parent = star

    local hurdle = makePart(root, &quot;JumpHurdle&quot;, Vector3.new(14.5, 2.0, 1.8), CFrame.new(0, 1.2, 27), Color3.fromRGB(118, 82, 54), Enum.Material.WoodPlanks)
    addBillboard(hurdle, &quot;JUMP&quot;, 92, 30, 13, 16)

    local trigger = makePart(root, &quot;QuestionTrigger&quot;, Vector3.new(18, 8, 3), CFrame.new(0, 4, 33), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
    trigger.Transparency = 1
    trigger.CanCollide = false

    makeAnswerPad(root, 1, 35)
    makeAnswerPad(root, 2, 39)
    makeAnswerPad(root, 3, 43)

    makePart(root, &quot;GatePillarL&quot;, Vector3.new(1.8, 7, 1.8), CFrame.new(-8.7, 3.5, 47), Color3.fromRGB(98, 101, 91), Enum.Material.Rock)
    makePart(root, &quot;GatePillarR&quot;, Vector3.new(1.8, 7, 1.8), CFrame.new(8.7, 3.5, 47), Color3.fromRGB(98, 101, 91), Enum.Material.Rock)
    local gateTop = makePart(root, &quot;GateTop&quot;, Vector3.new(18.8, 1.6, 1.8), CFrame.new(0, 7.0, 47), Color3.fromRGB(98, 101, 91), Enum.Material.Rock)
    addBillboard(gateTop, &quot;LIGHT THE FIVE LANTERNS&quot;, 210, 38, 13, 26)

    local gate = makePart(root, &quot;LearningGate&quot;, Vector3.new(15.5, 5.4, 0.7), CFrame.new(0, 3.15, 47), Color3.fromRGB(104, 211, 205), Enum.Material.ForceField)
    gate.Transparency = 0.42

    local lanterns = Instance.new(&quot;Folder&quot;)
    lanterns.Name = &quot;LearningLanterns&quot;
    lanterns.Parent = root
    for index = 1, 5 do
        local side = index % 2 == 0 and -1 or 1
        local z = 35 + index * 2.15
        local x = side * 8.45
        local post = makePart(lanterns, &quot;LanternPost&quot; .. index, Vector3.new(0.42, 2.5, 0.42), CFrame.new(x, 1.25, z), Color3.fromRGB(93, 65, 45), Enum.Material.Wood)
        post.CanCollide = false
        local lantern = makePart(lanterns, &quot;Lantern&quot; .. index, Vector3.new(1.05, 1.05, 1.05), CFrame.new(x, 2.85, z), Color3.fromRGB(76, 82, 82), Enum.Material.SmoothPlastic)
        lantern.Shape = Enum.PartType.Ball
        lantern.CanCollide = false
        lantern.CanTouch = false
    end

    local maze = Instance.new(&quot;Folder&quot;)
    maze.Name = &quot;MiniMaze&quot;
    maze.Parent = root
    local hedgeColor = Color3.fromRGB(54, 110, 76)
    makePart(maze, &quot;WallA&quot;, Vector3.new(14, 3.5, 1.6), CFrame.new(-3.25, 1.75, 56), hedgeColor, Enum.Material.Grass)
    makePart(maze, &quot;WallB&quot;, Vector3.new(14, 3.5, 1.6), CFrame.new(3.25, 1.75, 65), hedgeColor, Enum.Material.Grass)
    makePart(maze, &quot;WallC&quot;, Vector3.new(14, 3.5, 1.6), CFrame.new(-3.25, 1.75, 74), hedgeColor, Enum.Material.Grass)

    makePathLantern(maze, 1, 7.2, 55.5)
    makePathLantern(maze, 2, -7.2, 64.5)
    makePathLantern(maze, 3, 7.2, 73.5)
    makePathLantern(maze, 4, 0, 80.5)

    local finish = makePart(root, &quot;FinishPad&quot;, Vector3.new(8, 0.22, 6), CFrame.new(0, 0.68, 83), Color3.fromRGB(239, 193, 90), Enum.Material.Neon)
    finish.Transparency = 0.48
    finish.CanCollide = false

    local chestPlatform = makePart(root, &quot;ChestPlatform&quot;, Vector3.new(7.5, 0.75, 6.5), CFrame.new(0, 0.85, 89), Color3.fromRGB(107, 104, 91), Enum.Material.Rock)

    local chest = Instance.new(&quot;Model&quot;)
    chest.Name = &quot;RewardChest&quot;
    chest.Parent = root
    local chestBase = makePart(chest, &quot;Base&quot;, Vector3.new(5.2, 2.4, 3.8), CFrame.new(0, 2.35, 89), Color3.fromRGB(123, 72, 43), Enum.Material.WoodPlanks)
    local lid = makePart(chest, &quot;Lid&quot;, Vector3.new(5.2, 1.15, 3.8), CFrame.new(0, 4.1, 89), Color3.fromRGB(151, 91, 48), Enum.Material.WoodPlanks)
    makePart(chest, &quot;BandL&quot;, Vector3.new(0.42, 3.25, 3.92), CFrame.new(-1.55, 3.05, 89), Color3.fromRGB(219, 171, 70), Enum.Material.Metal)
    makePart(chest, &quot;BandR&quot;, Vector3.new(0.42, 3.25, 3.92), CFrame.new(1.55, 3.05, 89), Color3.fromRGB(219, 171, 70), Enum.Material.Metal)
    makePart(chest, &quot;Lock&quot;, Vector3.new(1.15, 1.2, 0.38), CFrame.new(0, 3.0, 87.0), Color3.fromRGB(255, 216, 87), Enum.Material.Metal)

    local glowCore = makePart(chest, &quot;GlowCore&quot;, Vector3.new(3.9, 0.3, 2.6), CFrame.new(0, 3.35, 89), Color3.fromRGB(255, 229, 103), Enum.Material.Neon)
    glowCore.Transparency = 1
    glowCore.CanCollide = false
    glowCore.CanTouch = false
    glowCore.CanQuery = false

    local chestLight = Instance.new(&quot;PointLight&quot;)
    chestLight.Name = &quot;RewardLight&quot;
    chestLight.Color = glowCore.Color
    chestLight.Range = 20
    chestLight.Brightness = 0
    chestLight.Enabled = false
    chestLight.Parent = glowCore

    local prompt = Instance.new(&quot;ProximityPrompt&quot;)
    prompt.Name = &quot;OpenPrompt&quot;
    prompt.ActionText = &quot;Open&quot;
    prompt.ObjectText = &quot;Pip&apos;s Chest&quot;
    prompt.HoldDuration = 0
    prompt.MaxActivationDistance = 9
    prompt.RequiresLineOfSight = false
    prompt.Enabled = false
    prompt.Parent = chestBase

    local replay = makePart(root, &quot;ReplayPad&quot;, Vector3.new(6, 0.2, 4), CFrame.new(0, 0.68, 98), Color3.fromRGB(130, 190, 179), Enum.Material.SmoothPlastic)
    replay.Transparency = 0.35
    replay.CanCollide = false
    addBillboard(replay, &quot;Play again&quot;, 110, 30, 12, 14)

    return {
        root = root,
        spawn = spawn,
        star = star,
        hurdle = hurdle,
        questionTrigger = trigger,
        answerPads = { root.Answer1, root.Answer2, root.Answer3 },
        gate = gate,
        lanterns = lanterns,
        maze = maze,
        finish = finish,
        chest = chest,
        replay = replay,
    }
end

return WorldBuilder
</string>
