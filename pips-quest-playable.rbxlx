      <Item class="LocalScript" referent="12">
        <Properties>
          <string name="Name">MobileHUD</string>
          <string name="Source">local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)

local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild(&quot;PipsQuestEvent&quot;)
local playerGui = player:WaitForChild(&quot;PlayerGui&quot;)

local old = playerGui:FindFirstChild(&quot;PipsQuestHUD&quot;)
if old then old:Destroy() end

local gui = Instance.new(&quot;ScreenGui&quot;)
gui.Name = &quot;PipsQuestHUD&quot;
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.DisplayOrder = 20
gui.Parent = playerGui

local function round(instance, radius)
    local corner = Instance.new(&quot;UICorner&quot;)
    corner.CornerRadius = UDim.new(0, radius or 14)
    corner.Parent = instance
end

local function stroke(instance, transparency)
    local item = Instance.new(&quot;UIStroke&quot;)
    item.Thickness = 1.5
    item.Transparency = transparency or 0.55
    item.Color = Color3.fromRGB(255, 255, 255)
    item.Parent = instance
end

local top = Instance.new(&quot;Frame&quot;)
top.Name = &quot;ObjectivePill&quot;
top.AnchorPoint = Vector2.new(0.5, 0)
top.Position = UDim2.new(0.5, 0, 0, 10)
top.Size = UDim2.new(0.42, 0, 0, 38)
top.BackgroundColor3 = Color3.fromRGB(250, 252, 248)
top.BackgroundTransparency = 0.12
top.Visible = false
top.Parent = gui
round(top, 16)
stroke(top, 0.76)

local topConstraint = Instance.new(&quot;UISizeConstraint&quot;)
topConstraint.MaxSize = Vector2.new(330, 40)
topConstraint.MinSize = Vector2.new(205, 36)
topConstraint.Parent = top

local status = Instance.new(&quot;TextLabel&quot;)
status.Name = &quot;Status&quot;
status.BackgroundTransparency = 1
status.Position = UDim2.fromOffset(12, 3)
status.Size = UDim2.new(1, -62, 1, -6)
status.Font = Enum.Font.GothamSemibold
status.Text = &quot;&quot;
status.TextColor3 = Color3.fromRGB(38, 53, 48)
status.TextSize = 13
status.TextWrapped = false
status.TextTruncate = Enum.TextTruncate.AtEnd
status.TextXAlignment = Enum.TextXAlignment.Left
status.Parent = top

local progress = Instance.new(&quot;TextLabel&quot;)
progress.Name = &quot;Progress&quot;
progress.AnchorPoint = Vector2.new(1, 0.5)
progress.Position = UDim2.new(1, -7, 0.5, 0)
progress.Size = UDim2.fromOffset(44, 27)
progress.BackgroundColor3 = Color3.fromRGB(126, 229, 191)
progress.TextColor3 = Color3.fromRGB(25, 54, 47)
progress.Font = Enum.Font.GothamBold
progress.TextSize = 13
progress.Text = &quot;0/5&quot;
progress.Parent = top
round(progress, 13)

local questionCard = Instance.new(&quot;Frame&quot;)
questionCard.Name = &quot;QuestionCard&quot;
questionCard.AnchorPoint = Vector2.new(1, 0.5)
questionCard.Position = UDim2.new(1, 80, 0.55, 0)
questionCard.Size = UDim2.new(0.5, 0, 0, 238)
questionCard.BackgroundColor3 = Color3.fromRGB(252, 253, 250)
questionCard.BackgroundTransparency = 0.04
questionCard.Visible = false
questionCard.Parent = gui
round(questionCard, 18)
stroke(questionCard, 0.42)

local cardConstraint = Instance.new(&quot;UISizeConstraint&quot;)
cardConstraint.MaxSize = Vector2.new(430, 285)
cardConstraint.MinSize = Vector2.new(325, 220)
cardConstraint.Parent = questionCard

local accent = Instance.new(&quot;Frame&quot;)
accent.Size = UDim2.new(0, 5, 1, -20)
accent.Position = UDim2.fromOffset(8, 10)
accent.BackgroundColor3 = Color3.fromRGB(91, 201, 169)
accent.BorderSizePixel = 0
accent.Parent = questionCard
round(accent, 3)

local meta = Instance.new(&quot;TextLabel&quot;)
meta.Name = &quot;Meta&quot;
meta.BackgroundTransparency = 1
meta.Position = UDim2.fromOffset(22, 9)
meta.Size = UDim2.new(1, -36, 0, 18)
meta.Font = Enum.Font.GothamBold
meta.Text = &quot;1/5&quot;
meta.TextColor3 = Color3.fromRGB(40, 132, 108)
meta.TextSize = 12
meta.TextXAlignment = Enum.TextXAlignment.Left
meta.Parent = questionCard

local prompt = Instance.new(&quot;TextLabel&quot;)
prompt.Name = &quot;Prompt&quot;
prompt.BackgroundTransparency = 1
prompt.Position = UDim2.fromOffset(22, 27)
prompt.Size = UDim2.new(1, -36, 0, 62)
prompt.Font = Enum.Font.GothamBold
prompt.TextColor3 = Color3.fromRGB(27, 37, 44)
prompt.TextSize = 17
prompt.TextWrapped = true
prompt.TextYAlignment = Enum.TextYAlignment.Center
prompt.TextXAlignment = Enum.TextXAlignment.Left
prompt.Parent = questionCard

local answerColors = {
    Color3.fromRGB(225, 238, 250),
    Color3.fromRGB(247, 228, 239),
    Color3.fromRGB(249, 239, 210),
    Color3.fromRGB(231, 237, 231),
}
local buttons = {}
for index = 1, 4 do
    local button = Instance.new(&quot;TextButton&quot;)
    button.Name = &quot;Answer&quot; .. index
    button.Position = UDim2.new(0, 22, 0, 94 + (index - 1) * 43)
    button.Size = UDim2.new(1, -36, 0, 36)
    button.BackgroundColor3 = answerColors[index]
    button.AutoButtonColor = true
    button.Font = Enum.Font.GothamSemibold
    button.TextColor3 = Color3.fromRGB(31, 43, 55)
    button.TextSize = 15
    button.TextWrapped = true
    button.Text = &quot;&quot;
    button.Visible = false
    button.Parent = questionCard
    round(button, 11)
    buttons[index] = button
end

local feedback = Instance.new(&quot;TextLabel&quot;)
feedback.Name = &quot;Feedback&quot;
feedback.BackgroundTransparency = 1
feedback.AnchorPoint = Vector2.new(0, 1)
feedback.Position = UDim2.new(0, 22, 1, -7)
feedback.Size = UDim2.new(1, -36, 0, 25)
feedback.Font = Enum.Font.GothamMedium
feedback.TextColor3 = Color3.fromRGB(70, 80, 83)
feedback.TextSize = 12
feedback.TextWrapped = true
feedback.TextXAlignment = Enum.TextXAlignment.Left
feedback.Text = &quot;&quot;
feedback.Parent = questionCard

local rewardCard = Instance.new(&quot;Frame&quot;)
rewardCard.Name = &quot;RewardCard&quot;
rewardCard.AnchorPoint = Vector2.new(0.5, 0.5)
rewardCard.Position = UDim2.fromScale(0.5, 0.42)
rewardCard.Size = UDim2.new(0.52, 0, 0, 98)
rewardCard.BackgroundColor3 = Color3.fromRGB(255, 251, 227)
rewardCard.BackgroundTransparency = 0.06
rewardCard.Visible = false
rewardCard.ZIndex = 100
rewardCard.Parent = gui
round(rewardCard, 20)
stroke(rewardCard, 0.32)

local rewardConstraint = Instance.new(&quot;UISizeConstraint&quot;)
rewardConstraint.MaxSize = Vector2.new(430, 110)
rewardConstraint.MinSize = Vector2.new(280, 92)
rewardConstraint.Parent = rewardCard

local rewardTitle = Instance.new(&quot;TextLabel&quot;)
rewardTitle.Size = UDim2.new(1, -24, 0, 42)
rewardTitle.Position = UDim2.fromOffset(12, 10)
rewardTitle.BackgroundTransparency = 1
rewardTitle.Font = Enum.Font.GothamBlack
rewardTitle.Text = &quot;STAR TRAIL!&quot;
rewardTitle.TextColor3 = Color3.fromRGB(122, 87, 26)
rewardTitle.TextScaled = true
rewardTitle.ZIndex = 101
rewardTitle.Parent = rewardCard

local rewardSubtitle = Instance.new(&quot;TextLabel&quot;)
rewardSubtitle.Size = UDim2.new(1, -24, 0, 30)
rewardSubtitle.Position = UDim2.fromOffset(12, 55)
rewardSubtitle.BackgroundTransparency = 1
rewardSubtitle.Font = Enum.Font.GothamBold
rewardSubtitle.Text = &quot;Pip unlocked a new trail&quot;
rewardSubtitle.TextColor3 = Color3.fromRGB(36, 121, 99)
rewardSubtitle.TextSize = 15
rewardSubtitle.ZIndex = 101
rewardSubtitle.Parent = rewardCard

local rewardSound = Instance.new(&quot;Sound&quot;)
rewardSound.SoundId = &quot;rbxasset://sounds/electronicpingshort.wav&quot;
rewardSound.Volume = 0.75
rewardSound.PlaybackSpeed = 1.08
rewardSound.Parent = gui

local currentQuestion
local currentProgress = 0
local currentTotal = 5
local sending = false
local selectedIndex = nil
local statusSerial = 0
local questionSerial = 0

local function setProgress(value, total)
    currentTotal = math.max(1, tonumber(total) or currentTotal or 5)
    currentProgress = math.clamp(tonumber(value) or currentProgress, 0, currentTotal)
    progress.Text = string.format(&quot;%d/%d&quot;, currentProgress, currentTotal)
end

local function hideObjective()
    top.Visible = false
end

local function setStatus(message, holdSeconds)
    if type(message) ~= &quot;string&quot; or message == &quot;&quot; then return end
    statusSerial += 1
    local serial = statusSerial
    status.Text = message
    top.Visible = true
    top.BackgroundTransparency = 0.12
    status.TextTransparency = 0
    progress.TextTransparency = 0
    progress.BackgroundTransparency = 0
    task.delay(holdSeconds or 1.8, function()
        if serial ~= statusSerial or currentQuestion then return end
        TweenService:Create(top, TweenInfo.new(0.22), { BackgroundTransparency = 1 }):Play()
        TweenService:Create(status, TweenInfo.new(0.22), { TextTransparency = 1 }):Play()
        TweenService:Create(progress, TweenInfo.new(0.22), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
        task.delay(0.24, function()
            if serial == statusSerial and not currentQuestion then
                top.Visible = false
            end
        end)
    end)
end

local function resetButtonLooks()
    for index, button in ipairs(buttons) do
        button.BackgroundColor3 = answerColors[index]
        button.TextColor3 = Color3.fromRGB(31, 43, 55)
        button.Rotation = 0
    end
end

local function enableAnswers(enabled)
    for _, button in ipairs(buttons) do
        button.Active = enabled
        button.AutoButtonColor = enabled
    end
end

local function showQuestion(question)
    questionSerial += 1
    currentQuestion = question
    selectedIndex = nil
    hideObjective()
    resetButtonLooks()

    local subject = question.subject or &quot;Grade 2&quot;
    local skill = tostring(question.skill or &quot;challenge&quot;):gsub(&quot;-&quot;, &quot; &quot;)
    meta.Text = string.format(&quot;%d/%d  •  %s&quot;, question.questionNumber or 1, question.questionTotal or 5, skill)
    prompt.Text = question.prompt or &quot;Choose the best answer.&quot;
    feedback.Text = &quot;&quot;
    feedback.TextColor3 = Color3.fromRGB(70, 80, 83)

    local count = question.options and #question.options or 0
    local height = count &gt;= 4 and 278 or 238
    questionCard.Size = UDim2.new(0.5, 0, 0, height)

    for index, button in ipairs(buttons) do
        local option = question.options and question.options[index]
        button.Visible = option ~= nil
        button.Text = option or &quot;&quot;
    end
    enableAnswers(true)
    setProgress(question.questionNumber or currentProgress, question.questionTotal or currentTotal)

    questionCard.Visible = true
    questionCard.Position = UDim2.new(1, 80, 0.55, 0)
    TweenService:Create(
        questionCard,
        TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        { Position = UDim2.new(1, -14, 0.55, 0) }
    ):Play()
end

local function hideQuestion(delaySeconds)
    local serial = questionSerial
    task.delay(delaySeconds or 0, function()
        if serial ~= questionSerial then return end
        TweenService:Create(
            questionCard,
            TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            { Position = UDim2.new(1, 70, 0.55, 0) }
        ):Play()
        task.delay(0.2, function()
            if serial == questionSerial then
                questionCard.Visible = false
                currentQuestion = nil
            end
        end)
    end)
end

local function celebrateReward()
    hideObjective()
    questionCard.Visible = false
    currentQuestion = nil

    rewardCard.Visible = true
    rewardCard.Size = UDim2.new(0.44, 0, 0, 72)
    rewardCard.BackgroundTransparency = 0.3
    rewardTitle.TextTransparency = 1
    rewardSubtitle.TextTransparency = 1
    rewardSound:Play()

    TweenService:Create(
        rewardCard,
        TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Size = UDim2.new(0.52, 0, 0, 98), BackgroundTransparency = 0.06 }
    ):Play()
    TweenService:Create(rewardTitle, TweenInfo.new(0.28), { TextTransparency = 0 }):Play()
    TweenService:Create(rewardSubtitle, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()

    task.delay(2.1, function()
        TweenService:Create(
            rewardCard,
            TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            { BackgroundTransparency = 1, Size = UDim2.new(0.46, 0, 0, 72) }
        ):Play()
        TweenService:Create(rewardTitle, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
        TweenService:Create(rewardSubtitle, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
        task.delay(0.32, function()
            rewardCard.Visible = false
        end)
    end)
end

for index, button in ipairs(buttons) do
    local answerIndex = index
    button.Activated:Connect(function()
        if sending or not currentQuestion or not button.Visible then return end
        sending = true
        selectedIndex = answerIndex
        feedback.Text = &quot;Checking…&quot;
        remote:FireServer(&quot;answer&quot;, answerIndex)
        task.delay(0.26, function() sending = false end)
    end)
end

remote.OnClientEvent:Connect(function(kind, payload)
    payload = payload or {}
    if payload.questionProgress ~= nil or payload.questionTotal ~= nil then
        setProgress(payload.questionProgress, payload.questionTotal)
    end

    if kind == &quot;reset&quot; then
        questionSerial += 1
        questionCard.Visible = false
        currentQuestion = nil
        setProgress(0, payload.questionTotal or 5)
        setStatus(&quot;Find the Quest Star&quot;, 1.7)
        return
    end

    if kind == &quot;status&quot; then
        setStatus(payload.message, 1.7)
        return
    end

    if kind == &quot;question&quot; then
        showQuestion(payload)
        return
    end

    if kind == &quot;feedback&quot; then
        feedback.Text = payload.message or (payload.correct and &quot;Nice!&quot; or &quot;Try again.&quot;)
        local button = selectedIndex and buttons[selectedIndex]
        if payload.correct then
            feedback.TextColor3 = Color3.fromRGB(28, 142, 104)
            if button then
                button.BackgroundColor3 = Color3.fromRGB(184, 239, 214)
                button.Text = &quot;✓  &quot; .. button.Text
            end
            enableAnswers(false)
            hideQuestion(0.46)
        else
            feedback.TextColor3 = Color3.fromRGB(154, 101, 26)
            if button then
                button.BackgroundColor3 = Color3.fromRGB(255, 224, 182)
                TweenService:Create(button, TweenInfo.new(0.08), { Rotation = -2 }):Play()
                task.delay(0.08, function()
                    TweenService:Create(button, TweenInfo.new(0.11), { Rotation = 2 }):Play()
                    task.delay(0.11, function()
                        TweenService:Create(button, TweenInfo.new(0.1), { Rotation = 0 }):Play()
                    end)
                end)
            end
            if payload.modeled then
                enableAnswers(false)
                hideQuestion(1.0)
            end
        end
        return
    end

    if kind == &quot;quest_ready&quot; then
        hideQuestion(0.25)
        setStatus(&quot;Gate open — keep going!&quot;, 1.5)
        return
    end

    if kind == &quot;reward&quot; then
        setProgress(payload.questionProgress or 5, payload.questionTotal or 5)
        celebrateReward()
    end
end)

print(&quot;[PIPS][HUD_READY] Minimal landscape HUD initialized&quot;)
</string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="13">
        <Properties>
          <string name="Name">PipCompanion</string>
          <string name="Source">local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild(&quot;PipsQuestEvent&quot;)

local pipModel
local pipRoot
local trail
local rootPart
local rewardUnlocked = false
local reactionUntil = 0
local celebrateUntil = 0

local function makePart(model, name, size, offset, color, material, shape)
    local part = Instance.new(&quot;Part&quot;)
    part.Name = name
    part.Size = size
    part.CFrame = offset
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Color = color
    part.Material = material or Enum.Material.SmoothPlastic
    if shape then part.Shape = shape end
    part.Parent = model
    return part
end

local function destroyPip()
    if pipModel then
        pipModel:Destroy()
        pipModel = nil
        pipRoot = nil
        trail = nil
    end
end

local function addRewardCrown()
    if not pipModel or pipModel:FindFirstChild(&quot;TrailStar&quot;) then return end
    local star = makePart(
        pipModel,
        &quot;TrailStar&quot;,
        Vector3.new(0.5, 0.5, 0.5),
        CFrame.new(0, 2.0, 0),
        Color3.fromRGB(255, 222, 79),
        Enum.Material.Neon,
        Enum.PartType.Ball
    )
    local light = Instance.new(&quot;PointLight&quot;)
    light.Range = 6
    light.Brightness = 1.4
    light.Color = star.Color
    light.Parent = star
end

local function createPip(character)
    destroyPip()
    rootPart = character:WaitForChild(&quot;HumanoidRootPart&quot;, 10)
    if not rootPart then return end

    pipModel = Instance.new(&quot;Model&quot;)
    pipModel.Name = &quot;PipCompanion&quot;
    pipModel.Parent = workspace

    pipRoot = makePart(pipModel, &quot;Root&quot;, Vector3.new(0.2, 0.2, 0.2), CFrame.new(), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
    pipRoot.Transparency = 1
    pipModel.PrimaryPart = pipRoot

    makePart(pipModel, &quot;Body&quot;, Vector3.new(1.65, 1.8, 1.5), CFrame.new(0, 0, 0), Color3.fromRGB(77, 202, 174), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
    makePart(pipModel, &quot;Head&quot;, Vector3.new(1.5, 1.35, 1.4), CFrame.new(0, 0.95, 0), Color3.fromRGB(132, 236, 205), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
    makePart(pipModel, &quot;Belly&quot;, Vector3.new(1.05, 1.0, 0.35), CFrame.new(0, -0.08, -0.67), Color3.fromRGB(233, 250, 225), Enum.Material.SmoothPlastic, Enum.PartType.Ball)

    makePart(pipModel, &quot;EyeL&quot;, Vector3.new(0.22, 0.28, 0.16), CFrame.new(-0.28, 1.08, -0.68), Color3.fromRGB(30, 48, 51), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
    makePart(pipModel, &quot;EyeR&quot;, Vector3.new(0.22, 0.28, 0.16), CFrame.new(0.28, 1.08, -0.68), Color3.fromRGB(30, 48, 51), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
    makePart(pipModel, &quot;CheekL&quot;, Vector3.new(0.24, 0.16, 0.11), CFrame.new(-0.5, 0.78, -0.66), Color3.fromRGB(247, 153, 172), Enum.Material.Neon, Enum.PartType.Ball)
    makePart(pipModel, &quot;CheekR&quot;, Vector3.new(0.24, 0.16, 0.11), CFrame.new(0.5, 0.78, -0.66), Color3.fromRGB(247, 153, 172), Enum.Material.Neon, Enum.PartType.Ball)
    makePart(pipModel, &quot;Smile&quot;, Vector3.new(0.34, 0.1, 0.1), CFrame.new(0, 0.72, -0.74), Color3.fromRGB(38, 60, 59), Enum.Material.SmoothPlastic)

    local wingL = makePart(pipModel, &quot;WingL&quot;, Vector3.new(0.22, 0.75, 1.05), CFrame.new(-0.92, 0.15, 0.18) * CFrame.Angles(0, 0, math.rad(-22)), Color3.fromRGB(221, 247, 243), Enum.Material.Glass)
    wingL.Transparency = 0.22
    local wingR = makePart(pipModel, &quot;WingR&quot;, Vector3.new(0.22, 0.75, 1.05), CFrame.new(0.92, 0.15, 0.18) * CFrame.Angles(0, 0, math.rad(22)), Color3.fromRGB(221, 247, 243), Enum.Material.Glass)
    wingR.Transparency = 0.22

    local a0 = Instance.new(&quot;Attachment&quot;)
    a0.Position = Vector3.new(0, 0.55, 0.45)
    a0.Parent = pipRoot
    local a1 = Instance.new(&quot;Attachment&quot;)
    a1.Position = Vector3.new(0, -0.55, 0.45)
    a1.Parent = pipRoot

    trail = Instance.new(&quot;Trail&quot;)
    trail.Attachment0 = a0
    trail.Attachment1 = a1
    trail.Lifetime = 0.8
    trail.MinLength = 0.04
    trail.FaceCamera = true
    trail.Enabled = rewardUnlocked
    trail.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 225, 75)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(126, 245, 201)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(246, 151, 203)),
    })
    trail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.9),
        NumberSequenceKeypoint.new(1, 0),
    })
    trail.Parent = pipRoot

    local glow = Instance.new(&quot;PointLight&quot;)
    glow.Brightness = 0.8
    glow.Range = 7
    glow.Color = Color3.fromRGB(126, 245, 201)
    glow.Parent = pipRoot

    if rewardUnlocked then addRewardCrown() end
end

local function burst(count)
    if not pipRoot then return end
    local emitter = Instance.new(&quot;ParticleEmitter&quot;)
    emitter.Texture = &quot;rbxasset://textures/particles/sparkles_main.dds&quot;
    emitter.Rate = 0
    emitter.Lifetime = NumberRange.new(0.55, 0.95)
    emitter.Speed = NumberRange.new(3, 6)
    emitter.SpreadAngle = Vector2.new(360, 360)
    emitter.LightEmission = 0.8
    emitter.Parent = pipRoot
    emitter:Emit(count or 18)
    task.delay(1.4, function()
        if emitter.Parent then emitter:Destroy() end
    end)
end

player.CharacterAdded:Connect(createPip)
if player.Character then task.defer(createPip, player.Character) end

RunService.RenderStepped:Connect(function()
    if not pipModel or not pipRoot or not rootPart or not rootPart.Parent then return end

    local now = os.clock()
    local bob = math.sin(now * 3.6) * 0.26
    local targetPosition

    if now &lt; celebrateUntil then
        local world = workspace:FindFirstChild(&quot;PipsQuestWorld&quot;)
        local chest = world and world:FindFirstChild(&quot;RewardChest&quot;)
        local glow = chest and chest:FindFirstChild(&quot;GlowCore&quot;)
        if glow then
            local angle = now * 4.4
            targetPosition = glow.Position + Vector3.new(math.cos(angle) * 2.4, 2.2 + math.sin(now * 7) * 0.35, math.sin(angle) * 2.4)
        end
    end

    if not targetPosition then
        targetPosition = (rootPart.CFrame * CFrame.new(-3.2, 2.35 + bob, 2.2)).Position
    end

    local camera = workspace.CurrentCamera
    local lookTarget = camera and camera.CFrame.Position or (targetPosition + Vector3.new(0, 0, -6))
    local desired = CFrame.lookAt(targetPosition, lookTarget)
    if now &lt; reactionUntil then
        desired = desired * CFrame.Angles(0, 0, math.sin(now * 18) * 0.22)
    end

    local current = pipModel:GetPivot()
    pipModel:PivotTo(current:Lerp(desired, now &lt; celebrateUntil and 0.22 or 0.14))
end)

remote.OnClientEvent:Connect(function(kind, payload)
    if kind == &quot;reward&quot; then
        rewardUnlocked = true
        if trail then trail.Enabled = true end
        addRewardCrown()
        celebrateUntil = os.clock() + 2.7
        reactionUntil = celebrateUntil
        burst(70)
        print(&quot;[PIPS][PIP_REWARD] Star Trail unlocked&quot;)
    elseif kind == &quot;feedback&quot; and payload and payload.correct then
        reactionUntil = os.clock() + 0.62
        burst(16)
    end
end)

print(&quot;[PIPS][PIP_READY] Expressive companion initialized&quot;)
